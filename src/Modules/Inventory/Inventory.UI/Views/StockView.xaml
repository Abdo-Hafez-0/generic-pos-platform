<UserControl x:Class="Inventory.UI.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Inventory.UI.Resources"
             xmlns:vm="clr-namespace:Inventory.UI.ViewModels"
             xmlns:screens="clr-namespace:Platform.Presentation.Screens;assembly=Platform.Presentation"
             xmlns:pres="clr-namespace:Platform.Presentation.Resources;assembly=Platform.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StockViewModel}">

    <!-- STOCK (FIX-01c). DataContext: StockViewModel. Texts: Resources/InventoryText.resx. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- MISS-08c: the main action, shown by the shell at the end of the title row -->
        <Button x:Key="{x:Static screens:ScreenParts.HeaderActions}" x:Name="NewReceiptButton" Style="{StaticResource Button.Primary}" Margin="0"
                Content="{x:Static res:InventoryText.ReceiveHeading}" Command="{Binding NewReceiptCommand}"/>
    </UserControl.Resources>

    <!-- MISS-08c (owner's choices): search, the plain list with "Correct" on each row; a receipt or a correction opens in a panel beside it -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- filter -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="StockSearchBox" Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static res:InventoryText.SearchHint}"
                         AutomationProperties.Name="{x:Static res:InventoryText.SearchHint}" ToolTip="{x:Static res:InventoryText.SearchHint}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <ComboBox x:Name="FilterWarehouseBox" Width="180" Margin="8,0,0,0" ItemsSource="{Binding FilterWarehouses}" SelectedItem="{Binding FilterWarehouse}" DisplayMemberPath="Name"
                          AutomationProperties.Name="{x:Static res:InventoryText.Warehouse}"/>
                <Button x:Name="StockSearchButton" Content="{x:Static res:InventoryText.Search}" Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="StockNoWarehousesText" Text="{x:Static res:InventoryText.NoWarehouses}" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,0,8"
                       Visibility="{Binding HasNoWarehouses, Converter={StaticResource VisibleWhenTrue}}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="StockGrid" ItemsSource="{Binding Stock}" SelectedItem="{Binding Selected}" IsReadOnly="True"
                  AutomationProperties.Name="{x:Static res:InventoryText.StockTitle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:InventoryText.Sku}" Binding="{Binding Sku}" Width="120" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:InventoryText.Product}" Binding="{Binding ProductName}" Width="*" MinWidth="140" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:InventoryText.Warehouse}" Binding="{Binding WarehouseName}" Width="140" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:InventoryText.OnHand}" Binding="{Binding OnHand, StringFormat=0.###}" Width="90" ElementStyle="{StaticResource Number}"/>
                <!-- the row's action -->
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="RowCorrectButton" Style="{StaticResource Button.Link}" Content="{x:Static res:InventoryText.Adjust}" Margin="4,0"
                                    Command="{Binding DataContext.CorrectRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- a receipt or a correction, beside the list -->
        <Border Grid.Column="1" Grid.RowSpan="2" x:Name="EditorPanel" Style="{StaticResource Panel.Side}" Width="320"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource VisibleWhenTrue}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="ReceiveButton" Style="{StaticResource Button.Primary}" Content="{x:Static res:InventoryText.Receive}" Command="{Binding ReceiveCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsReceiving, Converter={StaticResource VisibleWhenTrue}}"/>
                    <Button x:Name="AdjustButton" Style="{StaticResource Button.Primary}" Content="{x:Static res:InventoryText.Adjust}" Command="{Binding AdjustCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsCorrecting, Converter={StaticResource VisibleWhenTrue}}"/>
                    <Button x:Name="CancelStockButton" Content="{x:Static pres:PresentationText.PanelCancel}" Command="{Binding CancelCommand}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- receive -->
                        <StackPanel Visibility="{Binding IsReceiving, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Style="{StaticResource Box.Title}" Text="{x:Static res:InventoryText.ReceiveHeading}"/>
                            <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:InventoryText.ProductCode}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ReceiveCodeBox" Text="{Binding ReceiveCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:InventoryText.ProductCode}"/>
                            <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:InventoryText.Warehouse}"/>
                            <ComboBox x:Name="ReceiveWarehouseBox" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding ReceiveWarehouse}" DisplayMemberPath="Name"
                                      AutomationProperties.Name="{x:Static res:InventoryText.Warehouse}"/>
                            <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:InventoryText.Quantity}"/>
                            <TextBox x:Name="ReceiveQuantityBox" Width="120" HorizontalAlignment="Left" Text="{Binding ReceiveQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{x:Static res:InventoryText.Quantity}"/>
                            <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:InventoryText.ReferenceLabel}"/>
                            <TextBox x:Name="ReceiveReferenceBox" Text="{Binding ReceiveReference, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{x:Static res:InventoryText.Reference}" ToolTip="{x:Static res:InventoryText.Reference}"/>
                        </StackPanel>
                        <!-- correct the chosen line -->
                        <StackPanel Visibility="{Binding IsCorrecting, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Style="{StaticResource Box.Title}" Text="{x:Static res:InventoryText.CorrectTitle}"/>
                            <TextBlock Text="{Binding Selected.ProductName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Selected.WarehouseName}" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:InventoryText.AdjustBy}"/>
                            <TextBox x:Name="AdjustByBox" Width="120" HorizontalAlignment="Left" Text="{Binding AdjustBy, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{x:Static res:InventoryText.AdjustBy}"/>
                            <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:InventoryText.Reason}"/>
                            <ComboBox x:Name="AdjustReasonBox" ItemsSource="{Binding Reasons}" SelectedItem="{Binding AdjustReason}" DisplayMemberPath="Name"
                                      AutomationProperties.Name="{x:Static res:InventoryText.Reason}"/>
                            <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:InventoryText.Notes}"/>
                            <TextBox x:Name="AdjustNotesBox" Text="{Binding AdjustNotes, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{x:Static res:InventoryText.Notes}" ToolTip="{x:Static res:InventoryText.Notes}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <TextBlock x:Name="StockInfoText" Text="{Binding ResultInfo}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
            <TextBlock x:Name="StockStatusText" Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap"/>
            <TextBlock x:Name="StockErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
