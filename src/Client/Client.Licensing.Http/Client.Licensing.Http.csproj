<Project Sdk="Microsoft.NET.Sdk">
  <!--
    HTTP transport for the license server. The ONLY client-side licensing project that references HttpClient.
    Client.Licensing (domain/application) depends on the ILicenseClient abstraction, never on this project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client.Licensing\Client.Licensing.csproj" />
    <ProjectReference Include="..\..\Licensing\Licensing.Contracts\Licensing.Contracts.csproj" />
    <ProjectReference Include="..\Client.Host\Client.Host.csproj" />
  </ItemGroup>
</Project>
