<UserControl x:Class="Client.Desktop.Screens.Support.SupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Client.Desktop.Resources"
             xmlns:vm="clr-namespace:Client.Desktop.Screens.Support"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SupportViewModel}">

    <!-- SUPPORT SCREEN (MISS-05). DataContext: SupportViewModel. Texts: Resources/SupportText.resx. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,4,16,4"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"/>
    </UserControl.Resources>

    <!-- MISS-08c (owner's choice: settings in two columns of white boxes): the support file and the crash reports side by side -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Box}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Box.Title}" Text="{x:Static res:SupportText.FileHeading}"/>
                        <TextBlock x:Name="SupportExplanation" Text="{x:Static res:SupportText.Explanation}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="{x:Static res:SupportText.LogFolder}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LogFolderText" Text="{Binding LogFolder}"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{x:Static res:SupportText.LogFiles}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LogFilesText" Text="{Binding LogFilesText}"/>
                        </Grid>
                        <Button x:Name="SaveSupportFileButton" Content="{x:Static res:SupportText.SaveFile}" Click="OnSave" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Style="{StaticResource Button.Primary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Box}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Box.Title}" Text="{x:Static res:SupportText.CrashReports}"/>
                        <TextBlock x:Name="NoCrashesText" Text="{x:Static res:SupportText.NoCrashes}" Visibility="{Binding HasNoCrashes, Converter={StaticResource VisibleWhenTrue}}"/>
                        <DataGrid x:Name="CrashGrid" ItemsSource="{Binding CrashReports}" IsReadOnly="True" MaxHeight="300"
                                  Visibility="{Binding HasCrashes, Converter={StaticResource VisibleWhenTrue}}"
                                  AutomationProperties.Name="{x:Static res:SupportText.CrashReports}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static res:SupportText.When}" Binding="{Binding WhenText}" Width="140" ElementStyle="{StaticResource Cell}"/>
                                <DataGridTextColumn Header="{x:Static res:SupportText.What}" Binding="{Binding Summary}" Width="*" ElementStyle="{StaticResource Cell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- what happened -->
            <TextBlock x:Name="SupportStatusText" Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Success}" Margin="0,4,0,0"/>
            <TextBlock x:Name="SupportErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
