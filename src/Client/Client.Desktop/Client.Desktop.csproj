<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Client.Host\Client.Host.csproj" />
    <ProjectReference Include="..\Client.ModuleHost\Client.ModuleHost.csproj" />
    <!-- Catalog module (Stage 5A) — CatalogHostingModule lives in Catalog.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Catalog\Catalog.Infrastructure\Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Catalog\Catalog.UI\Catalog.UI.csproj" />
    <!-- Inventory module (Stage 5B) — InventoryHostingModule lives in Inventory.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Inventory\Inventory.Infrastructure\Inventory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Inventory\Inventory.UI\Inventory.UI.csproj" />
    <!-- Sales module (Stage 5C) — SalesHostingModule lives in Sales.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Sales\Sales.Infrastructure\Sales.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Sales\Sales.UI\Sales.UI.csproj" />
    <!-- Licensing (Stage 6): offline evaluation + HTTP transport to the license server -->
    <ProjectReference Include="..\Client.Licensing\Client.Licensing.csproj" />
    <ProjectReference Include="..\Client.Licensing.Http\Client.Licensing.Http.csproj" />
    <!-- Updater (Stage 7): verified, recoverable updates + HTTP transport to the update server -->
    <ProjectReference Include="..\Client.Updater\Client.Updater.csproj" />
    <ProjectReference Include="..\Client.Updater.Http\Client.Updater.Http.csproj" />
    <!-- POS module (Stage 5D) - POSHostingModule lives in POS.Infrastructure -->
    <ProjectReference Include="..\..\Modules\POS\POS.Infrastructure\POS.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\POS\POS.UI\POS.UI.csproj" />
    <!-- Suppliers module (Stage 8) - SuppliersHostingModule lives in Suppliers.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Suppliers\Suppliers.Infrastructure\Suppliers.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Suppliers\Suppliers.UI\Suppliers.UI.csproj" />
    <!-- Customers module (Stage 8) - CustomersHostingModule lives in Customers.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Customers\Customers.Infrastructure\Customers.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Customers\Customers.UI\Customers.UI.csproj" />
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.*.json" Condition="Exists('appsettings.*.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- EF Core design-time tools: required for 'dotnet ef migrations' command -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
