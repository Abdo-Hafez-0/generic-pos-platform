<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stage 9 server infrastructure: EF Core persistence in the SERVER's own database (never the desktop SQLite file), file stores for package/backup bytes, and the composition helpers the server hosts use. No ASP.NET, no client, no business module, no signing keys. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cloud.Contracts\Cloud.Contracts.csproj" />
    <ProjectReference Include="..\LicenseServer\LicenseServer.Application\LicenseServer.Application.csproj" />
    <ProjectReference Include="..\UpdateServer\UpdateServer.Application\UpdateServer.Application.csproj" />
    <ProjectReference Include="..\BackupServer\BackupServer.Application\BackupServer.Application.csproj" />
    <ProjectReference Include="..\AdminPortal\AdminPortal.Application\AdminPortal.Application.csproj" />
    <ProjectReference Include="..\..\Licensing\Licensing.Contracts\Licensing.Contracts.csproj" />
    <ProjectReference Include="..\..\Updates\Updates.Contracts\Updates.Contracts.csproj" />
    <ProjectReference Include="..\..\Updates\Updates.Package\Updates.Package.csproj" />
    <ProjectReference Include="..\..\Security\Security.Es256\Security.Es256.csproj" />
  </ItemGroup>
</Project>
