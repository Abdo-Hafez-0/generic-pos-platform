<UserControl x:Class="Catalog.UI.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Catalog.UI.Resources"
             xmlns:vm="clr-namespace:Catalog.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CategoriesViewModel}">

    <!-- CATEGORIES AND UNITS (FIX-01c). DataContext: CategoriesViewModel. Texts: Resources/CatalogText.resx. -->
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="MinHeight" Value="200"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- MISS-08c (owner's choices): two white boxes side by side, each with its own add line and a plain table -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Box}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Box.Title}" Text="{x:Static res:CatalogText.Categories}"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" x:Name="AddCategoryButton" Content="{x:Static res:CatalogText.AddCategory}" Command="{Binding AddCategoryCommand}" Margin="8,0,0,0"/>
                    <TextBox DockPanel.Dock="Left" x:Name="CategoryNameBox" Width="150" Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static res:CatalogText.Name}"
                             AutomationProperties.Name="{x:Static res:CatalogText.Name}" ToolTip="{x:Static res:CatalogText.Name}" Margin="0,0,8,0"/>
                    <TextBox x:Name="CategoryDescriptionBox" Text="{Binding NewCategoryDescription, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static res:CatalogText.Description}"
                             AutomationProperties.Name="{x:Static res:CatalogText.Description}" ToolTip="{x:Static res:CatalogText.Description}"/>
                </DockPanel>
                <DataGrid x:Name="CategoryList" ItemsSource="{Binding Categories}" IsReadOnly="True" AutomationProperties.Name="{x:Static res:CatalogText.Categories}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:CatalogText.Name}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="{x:Static res:CatalogText.Description}" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource Cell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Box}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Box.Title}" Text="{x:Static res:CatalogText.Units}"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" x:Name="AddUnitButton" Content="{x:Static res:CatalogText.AddUnit}" Command="{Binding AddUnitCommand}" Margin="8,0,0,0"/>
                    <TextBox DockPanel.Dock="Right" x:Name="UnitAbbreviationBox" Width="90" Text="{Binding NewUnitAbbreviation, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static res:CatalogText.Abbreviation}"
                             AutomationProperties.Name="{x:Static res:CatalogText.Abbreviation}" ToolTip="{x:Static res:CatalogText.Abbreviation}" Margin="8,0,0,0"/>
                    <TextBox x:Name="UnitNameBox" Text="{Binding NewUnitName, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static res:CatalogText.Name}"
                             AutomationProperties.Name="{x:Static res:CatalogText.Name}" ToolTip="{x:Static res:CatalogText.Name}"/>
                </DockPanel>
                <DataGrid x:Name="UnitList" ItemsSource="{Binding Units}" IsReadOnly="True" AutomationProperties.Name="{x:Static res:CatalogText.Units}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:CatalogText.Name}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="{x:Static res:CatalogText.Abbreviation}" Binding="{Binding Abbreviation}" Width="110" ElementStyle="{StaticResource Cell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,0">
            <TextBlock x:Name="CategoriesStatusText" Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap"/>
            <TextBlock x:Name="CategoriesErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
