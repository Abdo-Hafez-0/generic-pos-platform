<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI depends on Application (use cases) and Contracts (DTOs) only.
         NO reference to POS.Infrastructure or POS.Domain directly. -->
    <ProjectReference Include="..\POS.Application\POS.Application.csproj" />
    <ProjectReference Include="..\POS.Contracts\POS.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Platform\Platform.Core\Platform.Core.csproj" />
    <!-- FIX-01b: the screen declaration, the per-action runner and the view-model base of the shell -->
    <ProjectReference Include="..\..\..\Platform\Platform.Presentation\Platform.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\PosText.resx"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedClassName="PosText"
                      StronglyTypedNamespace="POS.UI.Resources"
                      StronglyTypedFileName="$(IntermediateOutputPath)PosText.Designer.cs"
                      PublicClass="true" />
  </ItemGroup>
</Project>
