<UserControl x:Class="Users.UI.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Users.UI.Resources"
             xmlns:vm="clr-namespace:Users.UI.ViewModels"
             xmlns:screens="clr-namespace:Platform.Presentation.Screens;assembly=Platform.Presentation"
             xmlns:pres="clr-namespace:Platform.Presentation.Resources;assembly=Platform.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UsersViewModel}">

    <!--
        USERS (FIX-01e). DataContext: UsersViewModel. Texts: Resources/UsersText.resx.
        Passwords are typed into PasswordBox controls and handed to the view model by the code-behind at the moment of use; they are never
        bound, stored or shown (the Stage 11 rule of the sign-in window).
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,4,10,4"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"/>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"/>

        <!-- MISS-08c: the main action, shown by the shell at the end of the title row -->
        <Button x:Key="{x:Static screens:ScreenParts.HeaderActions}" x:Name="NewUserButton" Style="{StaticResource Button.Primary}" Margin="0"
                Content="{x:Static res:UsersText.NewUserHeading}" Command="{Binding NewUserCommand}"/>
    </UserControl.Resources>

    <!-- MISS-08c (owner's choices): search and the plain list of users; beside it the chosen user in a white box (details, roles,
         password), or the new-user form opened by "New user" by the title -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- the users -->
        <DockPanel Grid.Column="0">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBox x:Name="UserSearchBox" Width="200" Margin="0,0,8,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static res:UsersText.SearchHint}"
                         AutomationProperties.Name="{x:Static res:UsersText.SearchHint}" ToolTip="{x:Static res:UsersText.SearchHint}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button x:Name="UserSearchButton" Content="{x:Static res:UsersText.Search}" Command="{Binding SearchCommand}" Margin="0,0,12,0"/>
                <CheckBox x:Name="ShowInactiveUsersBox" Content="{x:Static res:UsersText.ShowInactive}" IsChecked="{Binding ShowInactive}" VerticalAlignment="Center"/>
            </WrapPanel>
            <DataGrid x:Name="UserGrid" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True"
                      AutomationProperties.Name="{x:Static res:UsersText.UsersTitle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:UsersText.Username}" Binding="{Binding User.Username}" Width="120" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="{x:Static res:UsersText.DisplayName}" Binding="{Binding User.DisplayName}" Width="*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="{x:Static res:UsersText.Status}" Binding="{Binding StatusText}" Width="80" ElementStyle="{StaticResource Cell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- nothing chosen yet -->
        <TextBlock Grid.Column="2" Text="{x:Static res:UsersText.SelectUser}" Foreground="{DynamicResource Brush.TextSubtle}" VerticalAlignment="Top" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding ShowsHint, Converter={StaticResource VisibleWhenTrue}}"/>

        <!-- a new user -->
        <Border Grid.Column="2" x:Name="NewUserPanel" Style="{StaticResource Panel.Side}" Margin="0" VerticalAlignment="Top"
                Visibility="{Binding IsCreating, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel>
                <TextBlock Style="{StaticResource Box.Title}" Text="{x:Static res:UsersText.NewUserHeading}"/>
                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:UsersText.Username}" Margin="0,0,0,4"/>
                <TextBox x:Name="NewUsernameBox" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:UsersText.Username}"/>
                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:UsersText.DisplayName}"/>
                <TextBox x:Name="NewDisplayNameBox" Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:UsersText.DisplayName}"/>
                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:UsersText.Email}"/>
                <TextBox x:Name="NewEmailBox" FlowDirection="LeftToRight" Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:UsersText.Email}"/>
                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:UsersText.TemporaryPassword}"/>
                <PasswordBox x:Name="NewPasswordBox" ToolTip="{x:Static res:UsersText.TemporaryPasswordHint}" AutomationProperties.Name="{x:Static res:UsersText.TemporaryPassword}"/>
                <TextBlock Text="{x:Static res:UsersText.TemporaryPasswordHint}" Foreground="{DynamicResource Brush.TextSubtle}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="CreateUserButton" Style="{StaticResource Button.Primary}" Content="{x:Static res:UsersText.CreateUser}" IsEnabled="{Binding CanCreate}" Click="OnCreate" Margin="0,0,8,0"/>
                    <Button x:Name="CancelNewUserButton" Content="{x:Static pres:PresentationText.PanelCancel}" Command="{Binding CancelNewCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- the chosen user -->
        <Border Grid.Column="2" Style="{StaticResource Box}" Margin="0" VerticalAlignment="Top" Visibility="{Binding ShowsUser, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel>
                <TextBlock x:Name="UserHeadingText" Style="{StaticResource Box.Title}" Text="{Binding UserHeading}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="{x:Static res:UsersText.DisplayName}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="EditDisplayNameBox" Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:UsersText.DisplayName}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{x:Static res:UsersText.Email}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="EditEmailBox" FlowDirection="LeftToRight" Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:UsersText.Email}"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{x:Static res:UsersText.Language}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="EditLanguageBox" HorizontalAlignment="Left" Width="200" Margin="0,4,0,0"
                              ItemsSource="{Binding Languages}" SelectedItem="{Binding EditLanguage}" DisplayMemberPath="Text"
                              AutomationProperties.Name="{x:Static res:UsersText.Language}"/>
                    <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,10,0,0">
                        <Button x:Name="SaveDetailsButton" Style="{StaticResource Button.Primary}" Content="{x:Static res:UsersText.SaveDetails}" Command="{Binding SaveDetailsCommand}" Margin="0,0,8,0"/>
                        <Button x:Name="DeactivateUserButton" Content="{x:Static res:UsersText.Deactivate}" Command="{Binding DeactivateCommand}" Margin="0,0,8,0"/>
                        <Button x:Name="ReactivateUserButton" Content="{x:Static res:UsersText.Reactivate}" Command="{Binding ReactivateCommand}"/>
                    </WrapPanel>
                </Grid>

                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:UsersText.Roles}" Margin="0,16,0,4"/>
                <ListBox x:Name="UserRoleList" Height="100" ItemsSource="{Binding UserRoles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name"
                         AutomationProperties.Name="{x:Static res:UsersText.Roles}"/>
                <WrapPanel Margin="0,8,0,0">
                    <ComboBox x:Name="RoleToAssignBox" Width="170" Margin="0,0,8,0" ItemsSource="{Binding AllRoles}" SelectedItem="{Binding RoleToAssign}" DisplayMemberPath="Name"
                              AutomationProperties.Name="{x:Static res:UsersText.AssignRole}"/>
                    <Button x:Name="AssignRoleButton" Content="{x:Static res:UsersText.AssignRole}" Command="{Binding AssignRoleCommand}" Margin="0,0,8,0"/>
                    <Button x:Name="RemoveRoleButton" Content="{x:Static res:UsersText.RemoveRole}" Command="{Binding RemoveRoleCommand}"/>
                </WrapPanel>

                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:UsersText.ResetPassword}" Margin="0,16,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <PasswordBox x:Name="ResetPasswordBox" Width="200" Margin="0,0,8,0" AutomationProperties.Name="{x:Static res:UsersText.TemporaryPassword}"/>
                    <Button x:Name="ResetPasswordButton" Content="{x:Static res:UsersText.ResetPassword}" Click="OnResetPassword"/>
                </StackPanel>
                <TextBlock Text="{x:Static res:UsersText.TemporaryPasswordHint}" Foreground="{DynamicResource Brush.TextSubtle}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <TextBlock x:Name="UsersInfoText" Text="{Binding ResultInfo}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
            <TextBlock x:Name="UsersStatusText" Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap"/>
            <TextBlock x:Name="UsersErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
