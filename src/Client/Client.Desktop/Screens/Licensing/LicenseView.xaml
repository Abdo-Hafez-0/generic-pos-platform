<UserControl x:Class="Client.Desktop.Screens.Licensing.LicenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Client.Desktop.Resources"
             xmlns:vm="clr-namespace:Client.Desktop.Screens.Licensing"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LicenseViewModel}">

    <!-- LICENSE SCREEN. DataContext: LicenseViewModel. Texts: Resources/LicenseText.resx. The activation key is typed, never displayed elsewhere. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Margin" Value="0,4,16,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <!-- what the installation is licensed for -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="{x:Static res:LicenseText.State}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StateText" Text="{Binding StateText}" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{x:Static res:LicenseText.Customer}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CustomerText" Text="{Binding CustomerText}"/>
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{x:Static res:LicenseText.ValidUntil}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ValidUntilText" Text="{Binding ValidUntilText}"/>
                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{x:Static res:LicenseText.RenewBy}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RenewByText" Text="{Binding RenewByText}"/>
                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{x:Static res:LicenseText.Modules}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ModulesText" Text="{Binding ModulesText}"/>
                <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="{x:Static res:LicenseText.InstallationId}" MaxWidth="260"/>
                <!-- read-only text box so the ID can be selected and copied -->
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="InstallationIdBox" Text="{Binding InstallationIdText, Mode=OneWay}" IsReadOnly="True"
                         Background="Transparent" Foreground="#CDD6F4" BorderThickness="0" VerticalAlignment="Center" FontFamily="Consolas"
                         AutomationProperties.Name="{x:Static res:LicenseText.InstallationId}"/>
            </Grid>

            <TextBlock x:Name="NoticeText" Text="{Binding NoticeText}" Margin="0,12,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="#A6ADC8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRestricted}" Value="True">
                                <Setter Property="Foreground" Value="#F9E2AF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- activate -->
            <TextBlock Text="{x:Static res:LicenseText.ActivateHeading}" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,8"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="{x:Static res:LicenseText.ActivationKey}"/>
                <TextBox x:Name="ActivationKeyBox" Width="320" Padding="4,2" Text="{Binding ActivationKey, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Static res:LicenseText.ActivationKey}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ActivateCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button x:Name="ActivateButton" Content="{x:Static res:LicenseText.Activate}" Margin="12,0,0,0" Command="{Binding ActivateCommand}"/>
            </StackPanel>
            <TextBlock Text="{x:Static res:LicenseText.ActivateHint}" Foreground="#6C7086" FontSize="11" Margin="0,6,0,0"/>

            <!-- renew -->
            <Button x:Name="RenewButton" Content="{x:Static res:LicenseText.Renew}" HorizontalAlignment="Left" Margin="0,20,0,0" Command="{Binding RenewCommand}"
                    Visibility="{Binding HasVerifiedLicense, Converter={StaticResource VisibleWhenTrue}}"/>

            <!-- what happened -->
            <TextBlock x:Name="LicenseStatusText" Text="{Binding StatusMessage}" Foreground="#A6E3A1" Margin="0,16,0,0"/>
            <TextBlock x:Name="LicenseErrorText" Text="{Binding ErrorMessage}" Foreground="#F38BA8" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
