<UserControl x:Class="Pricing.UI.Views.PricesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Pricing.UI.Resources"
             xmlns:vm="clr-namespace:Pricing.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PricesViewModel}">

    <!-- PRICES (FIX-01d). DataContext: PricesViewModel. Texts: Resources/PricingText.resx. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="RowBackground" Value="#1E1E2E"/>
            <Setter Property="AlternatingRowBackground" Value="#232336"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#313244"/>
            <Setter Property="RowHeight" Value="26"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- price lists -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Heading}" Text="{x:Static res:PricingText.ListsHeading}"/>
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PricingText.Code}"/>
                <TextBox x:Name="ListCodeBox" Width="100" Text="{Binding NewListCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PricingText.Code}" ToolTip="{x:Static res:PricingText.Code}"/>
                <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PricingText.Name}"/>
                <TextBox x:Name="ListNameBox" Width="180" Text="{Binding NewListName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PricingText.Name}" ToolTip="{x:Static res:PricingText.Name}"/>
                <CheckBox x:Name="ListDefaultBox" Content="{x:Static res:PricingText.MakeDefault}" IsChecked="{Binding NewListDefault}"/>
                <Button x:Name="AddListButton" Content="{x:Static res:PricingText.AddList}" Command="{Binding AddListCommand}"/>
                <Button x:Name="SetDefaultButton" Content="{x:Static res:PricingText.SetDefault}" Command="{Binding SetDefaultCommand}"/>
                <Button x:Name="DeactivateListButton" Content="{x:Static res:PricingText.DeactivateList}" Command="{Binding DeactivateListCommand}"/>
            </WrapPanel>
        </StackPanel>
        <DataGrid Grid.Row="1" x:Name="PriceListGrid" ItemsSource="{Binding PriceLists}" SelectedItem="{Binding SelectedList}" AutomationProperties.Name="{x:Static res:PricingText.ListsHeading}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:PricingText.Code}" Binding="{Binding List.Code}" Width="120" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:PricingText.Name}" Binding="{Binding List.Name}" Width="*" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:PricingText.Default}" Binding="{Binding DefaultText}" Width="90" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:PricingText.Status}" Binding="{Binding StatusText}" Width="90" ElementStyle="{StaticResource Cell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- prices of one product -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource Heading}" Text="{x:Static res:PricingText.ProductHeading}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PricingText.ProductCode}"/>
                <TextBox x:Name="PriceProductBox" Width="180" Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PricingText.ProductCode}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding FindCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button x:Name="FindProductButton" Content="{x:Static res:PricingText.Find}" Command="{Binding FindCommand}"/>
                <TextBlock x:Name="PricingProductText" Text="{Binding ProductText}" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="CurrentPriceText" Text="{Binding CurrentPriceText}" Foreground="#A6E3A1" Margin="0,6,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="3" Margin="0,8,0,6" Visibility="{Binding HasProduct, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PricingText.List}"/>
            <ComboBox x:Name="NewPriceListBox" Width="120" Margin="0,0,10,0" ItemsSource="{Binding ActiveLists}" SelectedItem="{Binding NewPriceList}" DisplayMemberPath="Code"
                      AutomationProperties.Name="{x:Static res:PricingText.List}"/>
            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PricingText.Amount}"/>
            <TextBox x:Name="NewPriceAmountBox" Width="80" Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PricingText.Amount}"/>
            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PricingText.MinimumQuantity}"/>
            <TextBox x:Name="NewPriceMinQtyBox" Width="60" Text="{Binding NewMinimumQuantity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PricingText.MinimumQuantity}"/>
            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PricingText.ValidFrom}"/>
            <DatePicker x:Name="NewPriceFromPicker" Width="150" Margin="0,0,10,0" SelectedDate="{Binding NewFrom}" AutomationProperties.Name="{x:Static res:PricingText.ValidFrom}"/>
            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PricingText.ValidUntil}"/>
            <DatePicker x:Name="NewPriceUntilPicker" Width="150" Margin="0,0,10,0" SelectedDate="{Binding NewUntil}" ToolTip="{x:Static res:PricingText.ValidUntilHint}"
                        AutomationProperties.Name="{x:Static res:PricingText.ValidUntil}"/>
            <Button x:Name="AddPriceButton" Content="{x:Static res:PricingText.AddPrice}" Command="{Binding AddPriceCommand}"/>
            <Button x:Name="DeactivatePriceButton" Content="{x:Static res:PricingText.DeactivatePrice}" Command="{Binding DeactivatePriceCommand}"/>
        </WrapPanel>

        <DataGrid Grid.Row="4" x:Name="PriceGrid" ItemsSource="{Binding Prices}" SelectedItem="{Binding SelectedPrice}"
                  Visibility="{Binding HasProduct, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="{x:Static res:PricingText.ProductHeading}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:PricingText.List}" Binding="{Binding ListCode}" Width="110" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:PricingText.Amount}" Binding="{Binding Price.Amount, StringFormat=N2}" Width="100" ElementStyle="{StaticResource Number}"/>
                <DataGridTextColumn Header="{x:Static res:PricingText.MinimumQuantity}" Binding="{Binding Price.MinimumQuantity, StringFormat=0.###}" Width="90" ElementStyle="{StaticResource Number}"/>
                <DataGridTextColumn Header="{x:Static res:PricingText.ValidFrom}" Binding="{Binding FromText}" Width="120" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:PricingText.ValidUntil}" Binding="{Binding UntilText}" Width="120" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:PricingText.Status}" Binding="{Binding StatusText}" Width="*" ElementStyle="{StaticResource Cell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" Text="{x:Static res:PricingText.ValidUntilHint}" Foreground="#6C7086" FontSize="11" Margin="0,4,0,0"
                   Visibility="{Binding HasProduct, Converter={StaticResource VisibleWhenTrue}}"/>

        <StackPanel Grid.Row="6" Margin="0,8,0,0">
            <TextBlock x:Name="PricingStatusText" Text="{Binding StatusMessage}" Foreground="#A6E3A1" TextWrapping="Wrap"/>
            <TextBlock x:Name="PricingErrorText" Text="{Binding ErrorMessage}" Foreground="#F38BA8" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
