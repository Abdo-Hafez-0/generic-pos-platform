<UserControl x:Class="Purchasing.UI.Views.PurchaseOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Purchasing.UI.Resources"
             xmlns:vm="clr-namespace:Purchasing.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PurchaseOrdersViewModel}">

    <!-- PURCHASE ORDERS (FIX-01d). DataContext: PurchaseOrdersViewModel. Texts: Resources/PurchasingText.resx. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="RowBackground" Value="#1E1E2E"/>
            <Setter Property="AlternatingRowBackground" Value="#232336"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#313244"/>
            <Setter Property="RowHeight" Value="26"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- orders and a new order -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox x:Name="OrderStatusFilter" Width="140" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" DisplayMemberPath="Name"
                          AutomationProperties.Name="{x:Static res:PurchasingText.Status}"/>
                <Button x:Name="ShowOrdersButton" Content="{x:Static res:PurchasingText.Show}" Command="{Binding ShowCommand}"/>
            </StackPanel>
            <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="2" Style="{StaticResource Heading}" Text="{x:Static res:PurchasingText.NewHeading}"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{x:Static res:PurchasingText.SupplierHint}"/>
                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" x:Name="FindSupplierButton" Content="{x:Static res:PurchasingText.FindSupplier}" Command="{Binding FindSupplierCommand}" Margin="0"/>
                    <TextBox x:Name="SupplierSearchBox" Text="{Binding SupplierText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PurchasingText.SupplierHint}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding FindSupplierCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{x:Static res:PurchasingText.Supplier}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="SupplierBox" Margin="0,0,0,6" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name"
                          AutomationProperties.Name="{x:Static res:PurchasingText.Supplier}"/>
                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{x:Static res:PurchasingText.Reference}"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="OrderReferenceBox" Margin="0,0,0,6" Text="{Binding NewReference, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Static res:PurchasingText.Reference}"/>
                <Button Grid.Row="4" Grid.Column="1" x:Name="CreateOrderButton" HorizontalAlignment="Left" Content="{x:Static res:PurchasingText.CreateOrder}" Command="{Binding CreateCommand}"/>
            </Grid>
            <DataGrid x:Name="OrderGrid" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="{x:Static res:PurchasingText.ScreenTitle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:PurchasingText.Number}" Binding="{Binding Order.Number}" Width="110" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="{x:Static res:PurchasingText.Supplier}" Binding="{Binding Order.SupplierName}" Width="*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="{x:Static res:PurchasingText.Status}" Binding="{Binding StatusText}" Width="105" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="{x:Static res:PurchasingText.Total}" Binding="{Binding Order.TotalAmount, StringFormat=N2}" Width="90" ElementStyle="{StaticResource Number}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- the selected order -->
        <TextBlock Grid.Column="2" Text="{x:Static res:PurchasingText.SelectOrder}" Foreground="#6C7086" VerticalAlignment="Top"
                   Visibility="{Binding HasNoOrder, Converter={StaticResource VisibleWhenTrue}}"/>
        <DockPanel Grid.Column="2" Visibility="{Binding HasOrder, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock DockPanel.Dock="Top" x:Name="OrderHeadingText" Style="{StaticResource Heading}" Text="{Binding OrderHeading}"/>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <StackPanel Visibility="{Binding HasReturns, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PurchasingText.ReturnsHeading}" Margin="0,0,0,2"/>
                    <ItemsControl x:Name="ReturnList" ItemsSource="{Binding Returns}" AutomationProperties.Name="{x:Static res:PurchasingText.ReturnsHeading}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowsReturnControls, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,4" Text="{x:Static res:PurchasingText.ReturnHint}"/>
                    <WrapPanel>
                        <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PurchasingText.ReturnSelected}"/>
                        <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PurchasingText.ReturnQuantity}"/>
                        <TextBox x:Name="ReturnQuantityBox" Width="70" Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PurchasingText.ReturnQuantity}"/>
                        <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PurchasingText.ReturnReason}"/>
                        <TextBox x:Name="ReturnReasonBox" Width="200" Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PurchasingText.ReturnReason}"/>
                        <Button x:Name="ReturnButton" Content="{x:Static res:PurchasingText.ReturnButton}" Command="{Binding ReturnCommand}"/>
                    </WrapPanel>
                </StackPanel>
                <WrapPanel Visibility="{Binding IsDraft, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PurchasingText.ProductCode}"/>
                    <TextBox x:Name="LineCodeBox" Width="120" Text="{Binding LineCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PurchasingText.ProductCode}"/>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PurchasingText.Quantity}"/>
                    <TextBox x:Name="LineQuantityBox" Width="70" Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PurchasingText.Quantity}"/>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PurchasingText.UnitCost}"/>
                    <TextBox x:Name="LineCostBox" Width="80" Text="{Binding LineCost, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static res:PurchasingText.UnitCostHint}"
                             AutomationProperties.Name="{x:Static res:PurchasingText.UnitCost}"/>
                    <Button x:Name="AddLineButton" Content="{x:Static res:PurchasingText.AddLine}" Command="{Binding AddLineCommand}"/>
                    <Button x:Name="RemoveLineButton" Content="{x:Static res:PurchasingText.RemoveLine}" Command="{Binding RemoveLineCommand}"/>
                    <Button x:Name="SubmitOrderButton" Content="{x:Static res:PurchasingText.Submit}" Command="{Binding SubmitCommand}"/>
                </WrapPanel>
                <TextBlock Visibility="{Binding IsAwaitingGoods, Converter={StaticResource VisibleWhenTrue}}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="{x:Static res:PurchasingText.ReceiveNowHint}"/>
                <WrapPanel Visibility="{Binding IsAwaitingGoods, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PurchasingText.Warehouse}"/>
                    <ComboBox x:Name="ReceiveWarehouseBox" Width="160" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name"
                              AutomationProperties.Name="{x:Static res:PurchasingText.Warehouse}"/>
                    <Button x:Name="ReceiveOrderButton" Content="{x:Static res:PurchasingText.Receive}" Command="{Binding ReceiveCommand}"/>
                </WrapPanel>
                <WrapPanel Visibility="{Binding CanEnd, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PurchasingText.CancelReason}"/>
                    <TextBox x:Name="CancelReasonBox" Width="220" Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PurchasingText.CancelReason}"/>
                    <Button x:Name="CancelOrderButton" Content="{x:Static res:PurchasingText.CancelOrder}" Command="{Binding CancelOrderCommand}"/>
                    <Button x:Name="CloseShortButton" Content="{x:Static res:PurchasingText.CloseShort}" Command="{Binding CloseShortCommand}" ToolTip="{x:Static res:PurchasingText.CloseShortHint}"
                            Visibility="{Binding IsPartiallyReceived, Converter={StaticResource VisibleWhenTrue}}"/>
                </WrapPanel>
            </StackPanel>

            <DataGrid x:Name="OrderLineGrid" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" AutomationProperties.Name="{x:Static res:PurchasingText.Product}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:PurchasingText.ProductCode}" Binding="{Binding ProductSku}" Width="80" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="{x:Static res:PurchasingText.Product}" Binding="{Binding ProductName}" Width="*" MinWidth="110" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="{x:Static res:PurchasingText.Quantity}" Binding="{Binding Quantity, StringFormat=0.###}" Width="72" ElementStyle="{StaticResource Number}"/>
                    <DataGridTextColumn Header="{x:Static res:PurchasingText.UnitCost}" Binding="{Binding UnitCost, StringFormat=N2}" Width="75" ElementStyle="{StaticResource Number}"/>
                    <DataGridTextColumn Header="{x:Static res:PurchasingText.ReceivedColumn}" Binding="{Binding ReceivedQuantity, StringFormat=0.###}" Width="75" ElementStyle="{StaticResource Number}"/>
                    <DataGridTextColumn Header="{x:Static res:PurchasingText.Outstanding}" Binding="{Binding OutstandingQuantity, StringFormat=0.###}" Width="70" ElementStyle="{StaticResource Number}"/>
                    <DataGridTextColumn Header="{x:Static res:PurchasingText.ReturnedColumn}" Binding="{Binding ReturnedQuantity, StringFormat=0.###}" Width="75" ElementStyle="{StaticResource Number}"/>
                    <DataGridTemplateColumn Header="{x:Static res:PurchasingText.ReceiveNow}" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ReceiveNow, UpdateSourceTrigger=PropertyChanged}" Margin="2,1" TextAlignment="Right" ToolTip="{x:Static res:PurchasingText.ReceiveNowHint}"
                                         Visibility="{Binding CanReceive, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="{x:Static res:PurchasingText.ReceiveNow}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <TextBlock x:Name="PurchasingStatusText" Text="{Binding StatusMessage}" Foreground="#A6E3A1" TextWrapping="Wrap"/>
            <TextBlock x:Name="PurchasingErrorText" Text="{Binding ErrorMessage}" Foreground="#F38BA8" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
