<UserControl x:Class="POS.UI.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:POS.UI.Resources"
             xmlns:vm="clr-namespace:POS.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PosViewModel}">

    <!--
        CASHIER SCREEN (FIX-01b). DataContext: POS.UI.ViewModels.PosViewModel. All behaviour lives in the view model; every text comes from
        Resources/PosText.resx; no left/right-specific placement (the shell sets FlowDirection from the language).
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- numbers line up at their end (the end follows the reading direction) -->
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Who sells, and (until a till is open) where from -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock x:Name="CashierText" DockPanel.Dock="Left" Text="{Binding CashierText}" Foreground="#A6ADC8"/>
            <Button x:Name="CloseSessionButton" DockPanel.Dock="Right" Content="{x:Static res:PosText.CloseSession}"
                    Command="{Binding CloseSessionCommand}"
                    Visibility="{Binding HasOpenSession, Converter={StaticResource VisibleWhenTrue}}"/>
        </DockPanel>

        <StackPanel Grid.Row="1" x:Name="SessionPanel" Margin="0,0,0,12"
                    Visibility="{Binding NeedsSession, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static res:PosText.Warehouse}" Margin="0,0,8,0"/>
                <ComboBox x:Name="WarehouseBox" MinWidth="220" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}"
                          DisplayMemberPath="Name" AutomationProperties.Name="{x:Static res:PosText.Warehouse}"/>
                <Button x:Name="OpenSessionButton" Content="{x:Static res:PosText.OpenSession}" Margin="12,0,0,0" Command="{Binding OpenSessionCommand}"/>
            </StackPanel>
            <TextBlock x:Name="NoWarehousesText" Text="{x:Static res:PosText.NoWarehouses}" Foreground="#F9E2AF" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasNoWarehouses, Converter={StaticResource VisibleWhenTrue}}"/>
        </StackPanel>

        <!-- The sale in progress -->
        <Grid Grid.Row="2" x:Name="SalePanel" Visibility="{Binding HasOpenSession, Converter={StaticResource VisibleWhenTrue}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{x:Static res:PosText.ProductCode}" Margin="0,0,8,0"/>
                <TextBox x:Name="ProductCodeBox" Width="240" Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Static res:PosText.ProductCode}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="{x:Static res:PosText.Quantity}" Margin="12,0,8,0"/>
                <TextBox x:Name="QuantityBox" Width="70" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Static res:PosText.Quantity}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button x:Name="AddButton" Content="{x:Static res:PosText.Add}" Margin="12,0,0,0" Command="{Binding AddCommand}"/>
            </StackPanel>

            <DataGrid Grid.Row="1" x:Name="CartGrid" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                      Background="#181825" RowBackground="#1E1E2E" AlternatingRowBackground="#232336" Foreground="#CDD6F4"
                      BorderBrush="#313244" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244" RowHeight="28"
                      AutomationProperties.Name="{x:Static res:PosText.Product}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#313244"/>
                        <Setter Property="Foreground" Value="#A6ADC8"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:PosText.Product}" Binding="{Binding ProductName}" Width="*" MinWidth="160" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="{x:Static res:PosText.Quantity}" Binding="{Binding Quantity}" Width="90" ElementStyle="{StaticResource Number}"/>
                    <DataGridTextColumn Header="{x:Static res:PosText.UnitPrice}" Binding="{Binding UnitPrice, StringFormat=N2}" Width="120" ElementStyle="{StaticResource Number}"/>
                    <DataGridTextColumn Header="{x:Static res:PosText.LineTotal}" Binding="{Binding LineTotal, StringFormat=N2}" Width="130" ElementStyle="{StaticResource Number}"/>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
                <Button x:Name="RemoveButton" DockPanel.Dock="Left" Content="{x:Static res:PosText.RemoveSelected}"
                        Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItem, ElementName=CartGrid}"/>
                <Button x:Name="CheckoutButton" DockPanel.Dock="Right" Content="{x:Static res:PosText.Checkout}" MinWidth="120" Margin="16,0,0,0"
                        Command="{Binding CheckoutCommand}"/>
                <TextBlock x:Name="TotalText" DockPanel.Dock="Right" Text="{Binding Total, StringFormat=N2}" FontSize="18" FontWeight="Bold"/>
                <TextBlock DockPanel.Dock="Right" Text="{x:Static res:PosText.Total}" FontWeight="Bold" Margin="16,0,6,0"/>
                <TextBlock x:Name="SubtotalText" DockPanel.Dock="Right" Text="{Binding Subtotal, StringFormat=N2}"/>
                <TextBlock DockPanel.Dock="Right" Text="{x:Static res:PosText.Subtotal}" Margin="0,0,6,0"/>
            </DockPanel>
        </Grid>

        <!-- What happened -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="PosStatusText" Text="{Binding StatusMessage}" Foreground="#A6E3A1" TextWrapping="Wrap"/>
            <TextBlock x:Name="PosErrorText" Text="{Binding ErrorMessage}" Foreground="#F38BA8" TextWrapping="Wrap"/>
            <TextBlock x:Name="HardwareText" Text="{Binding HardwareMessage}" Foreground="#F9E2AF" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
