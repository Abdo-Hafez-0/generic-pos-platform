<UserControl x:Class="Reporting.UI.Views.BusinessOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Reporting.UI.Resources"
             xmlns:vm="clr-namespace:Reporting.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BusinessOverviewViewModel}">

    <!-- BUSINESS OVERVIEW (FIX-01d, read-only). DataContext: BusinessOverviewViewModel. Texts: Resources/ReportsText.resx. -->
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:ReportsText.From}"/>
            <DatePicker x:Name="ReportFromPicker" Width="170" SelectedDate="{Binding FromDate}" AutomationProperties.Name="{x:Static res:ReportsText.From}"/>
            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:ReportsText.To}" Margin="12,0,6,0"/>
            <DatePicker x:Name="ReportToPicker" Width="170" SelectedDate="{Binding ToDate}" AutomationProperties.Name="{x:Static res:ReportsText.To}"/>
            <Button x:Name="ShowReportButton" Content="{x:Static res:ReportsText.Show}" Margin="12,0,0,0" Command="{Binding ShowCommand}"/>
        </StackPanel>

        <!-- one card per section -->
        <ItemsControl Grid.Row="1" x:Name="ReportCards" ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Box}" Margin="0,0,12,12" Width="300" MinHeight="120">   <!-- MISS-08c: white boxes -->
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Box.Title}" AutomationProperties.Name="{Binding Title}"/>
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- sales per day -->
        <Border Grid.Row="2" Style="{StaticResource Box}" MaxWidth="624" HorizontalAlignment="Left" Margin="0">
            <DataGrid x:Name="DailySalesGrid" ItemsSource="{Binding Days}" IsReadOnly="True"
                      AutomationProperties.Name="{x:Static res:ReportsText.SalesCard}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:ReportsText.Day}" Binding="{Binding Date, StringFormat=&#x200E;{0:d}&#x200E;}" Width="*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="{x:Static res:ReportsText.SaleCount}" Binding="{Binding SaleCount}" Width="140" ElementStyle="{StaticResource Number}"/>
                    <DataGridTextColumn Header="{x:Static res:ReportsText.SalesTotal}" Binding="{Binding Total, StringFormat=N2}" Width="140" ElementStyle="{StaticResource Number}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" x:Name="ReportErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
