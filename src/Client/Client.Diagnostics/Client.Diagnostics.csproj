<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MISS-05: the desktop's own diagnostics - a rolling log FILE next to the database (secrets masked before writing), crash reports, and
    the support file (logs + crash reports, never the database) an administrator can send to the vendor. Everything stays on this PC:
    no HTTP, no telemetry (Architecture: "logs remain local"). No EF, no WPF, no business module.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\Platform.Core\Platform.Core.csproj" />
    <ProjectReference Include="..\..\Platform\Platform.Application\Platform.Application.csproj" />
    <!-- Client.Host: IHostingModule + Platform.Infrastructure DatabaseOptions (to locate the data folder only). -->
    <ProjectReference Include="..\Client.Host\Client.Host.csproj" />
  </ItemGroup>
</Project>
