{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Client": "Debug",
      "Platform.Infrastructure": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Model": "Error",
      "Microsoft.EntityFrameworkCore.Model.Validation": "Error"
    }
  },
  "Application": {
    "Name": "Generic POS Platform",
    "Version": "0.1.0-stage3"
  },
  "Ui": {
    "Culture": "en"
  },
  "Database": {
    "DatabaseFileName": "genericpos.db",
    "DatabaseFolder": "LocalAppData",
    "ApplicationSubDirectory": "GenericPOS"
  },
  "Hardware": {
    "Scanner": { "Type": "None" },
    "ReceiptPrinter": { "Type": "None" },
    "LabelPrinter": { "Type": "None" },
    "CashDrawer": { "Type": "None" },
    "Scale": { "Type": "None" }
  },
  "PosCash": {
    "DrawerCode": "MAIN"
  },
  "PosDiscount": {
    "MaximumPercent": 100
  },
  "PosReceipt": {
    "StoreName": "",
    "HeaderLines": [],
    "FooterLines": [ "Thank you!" ],
    "AutoPrintReceipt": true,
    "AutoOpenDrawerOnCashSale": true
  },
  "Security": {
    "Passwords": { "MinimumLength": 10, "MaximumLength": 128 },
    "Lockout": { "MaxFailedAttempts": 5, "LockoutMinutes": 15 },
    "PasswordHashing": { "Iterations": 600000 }
  },
  "Licensing": {
    "ProductId": "genericpos",
    "ServerBaseUrl": "",
    "GraceGrantsEntitlements": true,
    "ClockToleranceMinutes": 120,
    "AllowLegacyPlaintextIdentity": false,
    "TrustedKeys": []
  },
  "Updater": {
    "BaselineHostVersion": "1.0.0",
    "TargetFramework": "net10.0",
    "MaxStartupAttempts": 2,
    "ServerBaseUrl": "",
    "TrustedKeys": []
  }
}
