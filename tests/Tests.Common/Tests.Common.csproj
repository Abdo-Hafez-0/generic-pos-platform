<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared test support (in-memory SQLite module databases, repository root lookup). Test-only; never referenced by src. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fake hardware (Stage 10) implements the Platform hardware abstractions. -->
    <ProjectReference Include="..\..\src\Platform\Platform.Core\Platform.Core.csproj" />
    <ProjectReference Include="..\..\src\Platform\Platform.Application\Platform.Application.csproj" />
  </ItemGroup>
</Project>
