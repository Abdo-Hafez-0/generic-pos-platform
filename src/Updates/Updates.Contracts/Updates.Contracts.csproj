<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Shared update contracts between the client (Client.Updater), the UpdateServer and the packaging tools:
    package manifest, signed envelope, discovery messages, error codes.
    Contains NO keys, NO HTTP, NO file/zip IO, NO EF Core, NO UI and no business module references.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
