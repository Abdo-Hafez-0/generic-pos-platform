<UserControl x:Class="Users.UI.Views.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Users.UI.Resources"
             xmlns:vm="clr-namespace:Users.UI.ViewModels"
             xmlns:screens="clr-namespace:Platform.Presentation.Screens;assembly=Platform.Presentation"
             xmlns:pres="clr-namespace:Platform.Presentation.Resources;assembly=Platform.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RolesViewModel}">

    <!-- ROLES AND PERMISSIONS (FIX-01e). DataContext: RolesViewModel. Texts: Resources/UsersText.resx. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,4,10,4"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"/>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"/>

        <!-- MISS-08c: the main action, shown by the shell at the end of the title row -->
        <Button x:Key="{x:Static screens:ScreenParts.HeaderActions}" x:Name="NewRoleButton" Style="{StaticResource Button.Primary}" Margin="0"
                Content="{x:Static res:UsersText.NewRoleHeading}" Command="{Binding NewRoleCommand}"/>
    </UserControl.Resources>

    <!-- MISS-08c (owner's choices): the roles in a white box; beside them the chosen role's permissions, or the new-role form opened by
         "New role" by the title -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Box}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Box.Title}" Text="{x:Static res:UsersText.Roles}"/>
                <ListBox x:Name="RoleList" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name" BorderThickness="0"
                         AutomationProperties.Name="{x:Static res:UsersText.Roles}"/>
            </DockPanel>
        </Border>

        <!-- nothing chosen yet -->
        <TextBlock Grid.Column="2" Text="{x:Static res:UsersText.SelectRole}" Foreground="{DynamicResource Brush.TextSubtle}" VerticalAlignment="Top" Margin="0,8,0,0"
                   Visibility="{Binding ShowsHint, Converter={StaticResource VisibleWhenTrue}}"/>

        <!-- a new role -->
        <Border Grid.Column="2" x:Name="NewRolePanel" Style="{StaticResource Panel.Side}" Margin="0" VerticalAlignment="Top" MaxWidth="460" HorizontalAlignment="Left"
                Visibility="{Binding IsCreating, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel>
                <TextBlock Style="{StaticResource Box.Title}" Text="{x:Static res:UsersText.NewRoleHeading}"/>
                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:UsersText.RoleName}" Margin="0,0,0,4"/>
                <TextBox x:Name="NewRoleNameBox" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:UsersText.RoleName}"/>
                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:UsersText.Description}"/>
                <TextBox x:Name="NewRoleDescriptionBox" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:UsersText.Description}"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="CreateRoleButton" Style="{StaticResource Button.Primary}" Content="{x:Static res:UsersText.CreateRole}" Command="{Binding CreateCommand}" Margin="0,0,8,0"/>
                    <Button x:Name="CancelNewRoleButton" Content="{x:Static pres:PresentationText.PanelCancel}" Command="{Binding CancelNewCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- the chosen role's permissions -->
        <Border Grid.Column="2" Style="{StaticResource Box}" Margin="0" Visibility="{Binding ShowsRole, Converter={StaticResource VisibleWhenTrue}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="PermissionsHeadingText" Style="{StaticResource Box.Title}" Text="{Binding PermissionsHeading}"/>
                <DataGrid x:Name="PermissionGrid" ItemsSource="{Binding Permissions}" IsReadOnly="True" MinRowHeight="26"
                          AutomationProperties.Name="{x:Static res:UsersText.Permission}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{x:Static res:UsersText.Allowed}" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- two-way: a tick by mouse, keyboard or UI Automation asks the handler; the list is rebuilt from what was stored -->
                                    <CheckBox IsChecked="{Binding IsGranted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding Code}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{x:Static res:UsersText.Module}" Binding="{Binding Module}" Width="110" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="{x:Static res:UsersText.Permission}" Binding="{Binding Name}" Width="190" ElementStyle="{StaticResource Cell}"/>
                        <DataGridCheckBoxColumn Header="{x:Static res:UsersText.Sensitive}" Binding="{Binding IsSensitive, Mode=OneWay}" Width="80"/>
                        <DataGridTextColumn Header="{x:Static res:UsersText.Description}" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource Cell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <TextBlock x:Name="RolesStatusText" Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap"/>
            <TextBlock x:Name="RolesErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
