<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Client.Host\Client.Host.csproj" />
    <ProjectReference Include="..\Client.ModuleHost\Client.ModuleHost.csproj" />
    <!-- FIX-01a: screen declarations, per-action scopes, shared view-model base, UI culture -->
    <ProjectReference Include="..\..\Platform\Platform.Presentation\Platform.Presentation.csproj" />
    <!-- Catalog module (Stage 5A) — CatalogHostingModule lives in Catalog.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Catalog\Catalog.Infrastructure\Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Catalog\Catalog.UI\Catalog.UI.csproj" />
    <!-- Inventory module (Stage 5B) — InventoryHostingModule lives in Inventory.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Inventory\Inventory.Infrastructure\Inventory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Inventory\Inventory.UI\Inventory.UI.csproj" />
    <!-- Sales module (Stage 5C) — SalesHostingModule lives in Sales.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Sales\Sales.Infrastructure\Sales.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Sales\Sales.UI\Sales.UI.csproj" />
    <!-- Licensing (Stage 6): offline evaluation + HTTP transport to the license server -->
    <ProjectReference Include="..\Client.Security\Client.Security.csproj" />
    <ProjectReference Include="..\Client.Licensing\Client.Licensing.csproj" />
    <ProjectReference Include="..\Client.Licensing.Http\Client.Licensing.Http.csproj" />
    <!-- Updater (Stage 7): verified, recoverable updates + HTTP transport to the update server -->
    <ProjectReference Include="..\Client.Hardware\Client.Hardware.csproj" />
    <ProjectReference Include="..\Client.Updater\Client.Updater.csproj" />
    <ProjectReference Include="..\Client.Updater.Http\Client.Updater.Http.csproj" />
    <!-- POS module (Stage 5D) - POSHostingModule lives in POS.Infrastructure -->
    <ProjectReference Include="..\..\Modules\POS\POS.Infrastructure\POS.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\POS\POS.UI\POS.UI.csproj" />
    <!-- Reporting module (Stage 8) - ReportingHostingModule lives in Reporting.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Reporting\Reporting.Infrastructure\Reporting.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Reporting\Reporting.UI\Reporting.UI.csproj" />
    <!-- CashManagement module (Stage 8) - CashManagementHostingModule lives in CashManagement.Infrastructure -->
    <ProjectReference Include="..\..\Modules\CashManagement\CashManagement.Infrastructure\CashManagement.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\CashManagement\CashManagement.UI\CashManagement.UI.csproj" />
    <!-- Audit module (Stage 8) - AuditHostingModule lives in Audit.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Audit\Audit.Infrastructure\Audit.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Audit\Audit.UI\Audit.UI.csproj" />
    <!-- Users module (Stage 8) - UsersHostingModule lives in Users.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Users\Users.Infrastructure\Users.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Users\Users.UI\Users.UI.csproj" />
    <!-- Payments module (Stage 8) - PaymentsHostingModule lives in Payments.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Payments\Payments.Infrastructure\Payments.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Payments\Payments.UI\Payments.UI.csproj" />
    <!-- Pricing module (Stage 8) - PricingHostingModule lives in Pricing.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Pricing\Pricing.Infrastructure\Pricing.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Pricing\Pricing.UI\Pricing.UI.csproj" />
    <!-- Purchasing module (Stage 8) - PurchasingHostingModule lives in Purchasing.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Purchasing\Purchasing.Infrastructure\Purchasing.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Purchasing\Purchasing.UI\Purchasing.UI.csproj" />
    <!-- Suppliers module (Stage 8) - SuppliersHostingModule lives in Suppliers.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Suppliers\Suppliers.Infrastructure\Suppliers.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Suppliers\Suppliers.UI\Suppliers.UI.csproj" />
    <!-- Customers module (Stage 8) - CustomersHostingModule lives in Customers.Infrastructure -->
    <ProjectReference Include="..\..\Modules\Customers\Customers.Infrastructure\Customers.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Customers\Customers.UI\Customers.UI.csproj" />
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.*.json" Condition="Exists('appsettings.*.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- FIX-01a: shell texts (resources from the start; FIX-01 decision 4) -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\ShellText.resx"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedClassName="ShellText"
                      StronglyTypedNamespace="Client.Desktop.Resources"
                      StronglyTypedFileName="$(IntermediateOutputPath)ShellText.Designer.cs"
                      PublicClass="true" />
    <EmbeddedResource Update="Resources\LicenseText.resx"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedClassName="LicenseText"
                      StronglyTypedNamespace="Client.Desktop.Resources"
                      StronglyTypedFileName="$(IntermediateOutputPath)LicenseText.Designer.cs"
                      PublicClass="true" />
  </ItemGroup>
  <!-- The XAML temporary-assembly compile also needs the generated resource classes: src/Directory.Build.targets. -->

  <!-- EF Core design-time tools: required for 'dotnet ef migrations' command -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
