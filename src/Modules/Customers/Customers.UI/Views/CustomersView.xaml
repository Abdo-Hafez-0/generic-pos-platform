<UserControl x:Class="Customers.UI.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Customers.UI.Resources"
             xmlns:pres="clr-namespace:Platform.Presentation.Resources;assembly=Platform.Presentation"
             xmlns:screens="clr-namespace:Platform.Presentation.Screens;assembly=Platform.Presentation"
             xmlns:vm="clr-namespace:Customers.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CustomersViewModel}">

    <!-- CUSTOMERS (FIX-01d). DataContext: CustomersViewModel. Texts: Resources/CustomersText.resx. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,6,12,6"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"/>

        <!-- MISS-08c: the main action, shown by the shell at the end of the title row -->
        <Button x:Key="{x:Static screens:ScreenParts.HeaderActions}" x:Name="NewCustomerButton" Content="{x:Static res:CustomersText.New}" Command="{Binding NewCommand}" Style="{StaticResource Button.Primary}" Margin="0"/>
    </UserControl.Resources>

    <!-- MISS-08c (owner's choices): search, the plain list with Edit and "⋯" on each row, the editor in a panel beside it -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,2">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="CustomerSearchBox" Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{x:Static res:CustomersText.SearchHint}" AutomationProperties.Name="{x:Static res:CustomersText.SearchHint}" ToolTip="{x:Static res:CustomersText.SearchHint}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button x:Name="CustomerSearchButton" Content="{x:Static res:CustomersText.Search}" Margin="8,0,16,0" Command="{Binding SearchCommand}"/>
                <CheckBox x:Name="ShowInactiveCustomersBox" Content="{x:Static res:CustomersText.ShowInactive}" IsChecked="{Binding ShowInactive}"/>
            </StackPanel>
        </StackPanel>

        <!-- columns are not in the element tree: they read the view model through this element (x:Reference) -->
        <FrameworkElement x:Name="ColumnsSource" Visibility="Collapsed"/>
        <DataGrid IsReadOnly="True" Grid.Row="1" x:Name="CustomerGrid" ItemsSource="{Binding Customers}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{x:Static res:CustomersText.ScreenTitle}">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditRowCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:CustomersText.Code}" Binding="{Binding Customer.Code}" Width="110" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:CustomersText.Name}" Binding="{Binding Customer.Name}" Width="*" MinWidth="160" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:CustomersText.Email}" Binding="{Binding Customer.Email}" Visibility="{Binding DataContext.IsListMode, Source={x:Reference ColumnsSource}, Converter={StaticResource VisibleWhenTrue}}" Width="200" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:CustomersText.Phone}" Binding="{Binding Customer.Phone, StringFormat=&#x200E;{0}}" Width="140" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:CustomersText.Status}" Binding="{Binding StatusText}" Visibility="{Binding DataContext.IsListMode, Source={x:Reference ColumnsSource}, Converter={StaticResource VisibleWhenTrue}}" Width="90" ElementStyle="{StaticResource Cell}"/>
                <!-- the row's actions: Edit, and "⋯" for the rest (MISS-08c) -->
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,0">
                                <Button x:Name="RowEditButton" Style="{StaticResource Button.Link}" Content="{x:Static pres:PresentationText.RowEdit}"
                                        Command="{Binding DataContext.EditRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                <Button x:Name="RowMenuButton" Style="{StaticResource Button.RowMenu}" ToolTip="{x:Static pres:PresentationText.RowMoreActions}"
                                        AutomationProperties.Name="{x:Static pres:PresentationText.RowMoreActions}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="RowDeactivateItem" Header="{x:Static pres:PresentationText.RowDeactivate}" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.DeactivateRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem x:Name="RowReactivateItem" Header="{x:Static pres:PresentationText.RowReactivate}" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.ReactivateRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- the editor, beside the list (MISS-08c) -->
        <Border Grid.Column="1" Grid.RowSpan="2" x:Name="EditorPanel" Style="{StaticResource Panel.Side}" Width="380"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource VisibleWhenTrue}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="EditorTitle">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Box.Title}">
                            <Setter Property="Text" Value="{x:Static res:CustomersText.EditTitle}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNew}" Value="True">
                                    <Setter Property="Text" Value="{x:Static res:CustomersText.New}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource Button.Primary}" IsDefault="True" Margin="0,0,8,0" x:Name="SaveCustomerButton" Content="{x:Static res:CustomersText.Save}" Command="{Binding SaveCommand}"/>
                    <Button x:Name="CancelCustomerButton" Content="{x:Static res:CustomersText.Cancel}" Command="{Binding CancelCommand}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="CustomerEditor">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="{x:Static res:CustomersText.Code}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="CustomerCodeBox" Width="160" HorizontalAlignment="Left" Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsNew}" AutomationProperties.Name="{x:Static res:CustomersText.Code}"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{x:Static res:CustomersText.Name}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="CustomerNameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:CustomersText.Name}"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{x:Static res:CustomersText.Email}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="CustomerEmailBox" FlowDirection="LeftToRight" Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:CustomersText.Email}"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{x:Static res:CustomersText.Phone}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="CustomerPhoneBox" FlowDirection="LeftToRight" Width="220" HorizontalAlignment="Left" Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{x:Static res:CustomersText.Phone}"/>
                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{x:Static res:CustomersText.Notes}" VerticalAlignment="Top"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="CustomerNotesBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                 Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:CustomersText.Notes}"/>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <TextBlock x:Name="CustomersInfoText" Text="{Binding ResultInfo}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
            <TextBlock x:Name="CustomersStatusText" Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap"/>
            <TextBlock x:Name="CustomersErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
