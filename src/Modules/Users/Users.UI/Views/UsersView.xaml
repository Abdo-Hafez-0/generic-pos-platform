<UserControl x:Class="Users.UI.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Users.UI.Resources"
             xmlns:vm="clr-namespace:Users.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UsersViewModel}">

    <!--
        USERS (FIX-01e). DataContext: UsersViewModel. Texts: Resources/UsersText.resx.
        Passwords are typed into PasswordBox controls and handed to the view model by the code-behind at the moment of use; they are never
        bound, stored or shown (the Stage 11 rule of the sign-in window).
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Margin" Value="0,4,10,4"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#313244"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- the users, and a new user -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="UserSearchBox" Width="180" Margin="0,0,8,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Static res:UsersText.SearchHint}" ToolTip="{x:Static res:UsersText.SearchHint}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button x:Name="UserSearchButton" Content="{x:Static res:UsersText.Search}" Command="{Binding SearchCommand}"/>
                <CheckBox x:Name="ShowInactiveUsersBox" Content="{x:Static res:UsersText.ShowInactive}" IsChecked="{Binding ShowInactive}"/>
            </StackPanel>

            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="2" Style="{StaticResource Heading}" Text="{x:Static res:UsersText.NewUserHeading}"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{x:Static res:UsersText.Username}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="NewUsernameBox" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:UsersText.Username}"/>
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{x:Static res:UsersText.DisplayName}"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="NewDisplayNameBox" Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:UsersText.DisplayName}"/>
                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{x:Static res:UsersText.Email}"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="NewEmailBox" Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:UsersText.Email}"/>
                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{x:Static res:UsersText.TemporaryPassword}"/>
                <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="NewPasswordBox" ToolTip="{x:Static res:UsersText.TemporaryPasswordHint}" AutomationProperties.Name="{x:Static res:UsersText.TemporaryPassword}"/>
                <Button Grid.Row="5" Grid.Column="1" x:Name="CreateUserButton" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Content="{x:Static res:UsersText.CreateUser}" IsEnabled="{Binding CanCreate}" Click="OnCreate"/>
            </Grid>

            <DataGrid x:Name="UserGrid" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                      Background="#181825" RowBackground="#1E1E2E" AlternatingRowBackground="#232336" Foreground="#CDD6F4"
                      BorderBrush="#313244" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244" RowHeight="26"
                      AutomationProperties.Name="{x:Static res:UsersText.UsersTitle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:UsersText.Username}" Binding="{Binding User.Username}" Width="120" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="{x:Static res:UsersText.DisplayName}" Binding="{Binding User.DisplayName}" Width="*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="{x:Static res:UsersText.Status}" Binding="{Binding StatusText}" Width="80" ElementStyle="{StaticResource Cell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- the selected user -->
        <TextBlock Grid.Column="2" Text="{x:Static res:UsersText.SelectUser}" Foreground="#6C7086" VerticalAlignment="Top" TextWrapping="Wrap"
                   Visibility="{Binding HasNoUser, Converter={StaticResource VisibleWhenTrue}}"/>
        <StackPanel Grid.Column="2" Visibility="{Binding HasUser, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock x:Name="UserHeadingText" Style="{StaticResource Heading}" Text="{Binding UserHeading}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="{x:Static res:UsersText.DisplayName}"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="EditDisplayNameBox" Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:UsersText.DisplayName}"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{x:Static res:UsersText.Email}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="EditEmailBox" Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:UsersText.Email}"/>
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{x:Static res:UsersText.Language}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="EditLanguageBox" HorizontalAlignment="Left" Width="200" Margin="0,4,0,0"
                          ItemsSource="{Binding Languages}" SelectedItem="{Binding EditLanguage}" DisplayMemberPath="Text"
                          AutomationProperties.Name="{x:Static res:UsersText.Language}"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="SaveDetailsButton" Content="{x:Static res:UsersText.SaveDetails}" Command="{Binding SaveDetailsCommand}"/>
                    <Button x:Name="DeactivateUserButton" Content="{x:Static res:UsersText.Deactivate}" Command="{Binding DeactivateCommand}"/>
                    <Button x:Name="ReactivateUserButton" Content="{x:Static res:UsersText.Reactivate}" Command="{Binding ReactivateCommand}"/>
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource Heading}" Text="{x:Static res:UsersText.Roles}" Margin="0,16,0,6"/>
            <ListBox x:Name="UserRoleList" Height="110" ItemsSource="{Binding UserRoles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name"
                     AutomationProperties.Name="{x:Static res:UsersText.Roles}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <ComboBox x:Name="RoleToAssignBox" Width="170" Margin="0,0,8,0" ItemsSource="{Binding AllRoles}" SelectedItem="{Binding RoleToAssign}" DisplayMemberPath="Name"
                          AutomationProperties.Name="{x:Static res:UsersText.AssignRole}"/>
                <Button x:Name="AssignRoleButton" Content="{x:Static res:UsersText.AssignRole}" Command="{Binding AssignRoleCommand}"/>
                <Button x:Name="RemoveRoleButton" Content="{x:Static res:UsersText.RemoveRole}" Command="{Binding RemoveRoleCommand}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource Heading}" Text="{x:Static res:UsersText.ResetPassword}" Margin="0,16,0,6"/>
            <StackPanel Orientation="Horizontal">
                <PasswordBox x:Name="ResetPasswordBox" Width="200" Margin="0,0,8,0" AutomationProperties.Name="{x:Static res:UsersText.TemporaryPassword}"/>
                <Button x:Name="ResetPasswordButton" Content="{x:Static res:UsersText.ResetPassword}" Click="OnResetPassword"/>
            </StackPanel>
            <TextBlock Text="{x:Static res:UsersText.TemporaryPasswordHint}" Foreground="#6C7086" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <TextBlock x:Name="UsersInfoText" Text="{Binding ResultInfo}" Foreground="#A6ADC8" TextWrapping="Wrap"/>
            <TextBlock x:Name="UsersStatusText" Text="{Binding StatusMessage}" Foreground="#A6E3A1" TextWrapping="Wrap"/>
            <TextBlock x:Name="UsersErrorText" Text="{Binding ErrorMessage}" Foreground="#F38BA8" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
