<Window x:Class="Fiscal.UI.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:Fiscal.UI.Resources"
        xmlns:vm="clr-namespace:Fiscal.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OnboardingViewModel}"
        Title="{Binding Title}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Brush.Page}"
        AutomationProperties.AutomationId="OnboardingWindow">

    <!-- MISS-11d-3 (owner's choice A: one button, the steps ticked): onboarding this till with ZATCA, or renewing its certificate. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="90"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource Box}" Margin="16">
        <StackPanel>
            <TextBlock x:Name="OnboardingHintText" Text="{Binding Hint}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,0,0,8"/>

            <StackPanel Visibility="{Binding IsOnboarding, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.Environment}"/>
                <ComboBox x:Name="OnboardingEnvironmentBox" ItemsSource="{Binding Environments}" SelectedItem="{Binding Environment}" DisplayMemberPath="Text"
                          IsEnabled="{Binding CanChooseEnvironment}" AutomationProperties.Name="{x:Static res:FiscalText.Environment}"/>
                <TextBlock Text="{x:Static res:FiscalText.EnvironmentLockedHint}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,4,0,0"
                           Visibility="{Binding EnvironmentLocked, Converter={StaticResource VisibleWhenTrue}}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.Otp}"/>
            <TextBox x:Name="OtpBox" Text="{Binding Otp, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" MaxLength="20"
                     AutomationProperties.Name="{x:Static res:FiscalText.Otp}"/>

            <StackPanel Visibility="{Binding IsOnboarding, Converter={StaticResource VisibleWhenTrue}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.UnitName}"/>
                        <TextBox x:Name="UnitNameBox" Text="{Binding UnitName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                 AutomationProperties.Name="{x:Static res:FiscalText.UnitName}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.UnitBranch}"/>
                        <TextBox x:Name="UnitBranchBox" Text="{Binding Branch, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                 AutomationProperties.Name="{x:Static res:FiscalText.UnitBranch}"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.UnitIndustry}"/>
                        <TextBox x:Name="UnitIndustryBox" Text="{Binding Industry, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                 AutomationProperties.Name="{x:Static res:FiscalText.UnitIndustry}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.UnitLocation}"/>
                        <TextBox x:Name="UnitLocationBox" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                 AutomationProperties.Name="{x:Static res:FiscalText.UnitLocation}"/>
                    </StackPanel>
                </Grid>

                <!-- the steps, ticked as they are done -->
                <ItemsControl x:Name="StepsList" ItemsSource="{Binding Steps}" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OnboardingStepRow}">
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Mark}" FontWeight="SemiBold" AutomationProperties.Name="{Binding Mark}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Text}"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" FlowDirection="LeftToRight"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock x:Name="OnboardingErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" Margin="0,10,0,0" FlowDirection="LeftToRight"/>
            <TextBlock x:Name="OnboardingStatusText" Text="{Binding StatusMessage}" Margin="0,6,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="OnboardButton" Content="{Binding ActionText}" Style="{StaticResource Button.Primary}" Click="OnRun" IsDefault="True" Margin="0,0,8,0"
                        Visibility="{Binding CanRun, Converter={StaticResource VisibleWhenTrue}}"/>
                <Button x:Name="CloseOnboardingButton" Content="{x:Static res:FiscalText.Close}" IsCancel="True" Click="OnClose"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
