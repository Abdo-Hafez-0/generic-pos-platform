<UserControl x:Class="Audit.UI.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Audit.UI.Resources"
             xmlns:vm="clr-namespace:Audit.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AuditLogViewModel}">

    <!-- AUDIT LOG (FIX-01d, read-only). DataContext: AuditLogViewModel. Texts: Resources/AuditText.resx. -->
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:AuditText.Module}"/>
            <TextBox x:Name="AuditModuleBox" Width="120" Text="{Binding Module, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:AuditText.Module}"/>
            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:AuditText.Action}"/>
            <TextBox x:Name="AuditActionBox" Width="200" Text="{Binding Action, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:AuditText.Action}"/>
            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:AuditText.From}"/>
            <DatePicker x:Name="AuditFromPicker" Width="170" Margin="0,0,12,0" SelectedDate="{Binding FromDate}" AutomationProperties.Name="{x:Static res:AuditText.From}"/>
            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:AuditText.To}"/>
            <DatePicker x:Name="AuditToPicker" Width="170" Margin="0,0,12,0" SelectedDate="{Binding ToDate}" AutomationProperties.Name="{x:Static res:AuditText.To}"/>
            <Button x:Name="ShowAuditButton" Content="{x:Static res:AuditText.Show}" Command="{Binding ShowCommand}"/>
        </WrapPanel>

        <DataGrid Grid.Row="1" x:Name="AuditGrid" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" IsReadOnly="True"
                  AutomationProperties.Name="{x:Static res:AuditText.ScreenTitle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:AuditText.Time}" Binding="{Binding TimeText}" Width="160" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:AuditText.Module}" Binding="{Binding Entry.Module}" Width="110" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:AuditText.Action}" Binding="{Binding Entry.Action}" Width="230" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:AuditText.Actor}" Binding="{Binding Entry.ActorName}" Width="110" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:AuditText.Summary}" Binding="{Binding Entry.Summary}" Width="*" ElementStyle="{StaticResource Cell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" x:Name="AuditPageInfo" Text="{Binding PageInfo}" Foreground="{DynamicResource Brush.TextMuted}"/>
            <Button DockPanel.Dock="Right" x:Name="OlderButton" Content="{x:Static res:AuditText.Next}" Command="{Binding OlderCommand}" Margin="0"/>
            <Button DockPanel.Dock="Right" x:Name="NewerButton" Content="{x:Static res:AuditText.Previous}" Command="{Binding NewerCommand}"/>
        </DockPanel>

        <!-- MISS-08c: the chosen entry's details in a white box -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <Border Style="{StaticResource Box}" Margin="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Box.Title}" Text="{x:Static res:AuditText.Details}" Margin="0,0,0,6"/>
                    <TextBox x:Name="AuditDetailsBox" Text="{Binding DetailsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="60"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.Text}" VerticalContentAlignment="Top" AutomationProperties.Name="{x:Static res:AuditText.Details}"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="AuditErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
