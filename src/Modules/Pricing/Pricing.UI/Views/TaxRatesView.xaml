<UserControl x:Class="Pricing.UI.Views.TaxRatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Pricing.UI.Resources"
             xmlns:vm="clr-namespace:Pricing.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TaxRatesViewModel}">

    <!-- TAX RATES (FIX-08a). DataContext: TaxRatesViewModel. Texts: Resources/PricingText.resx. Prices include tax. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="RowBackground" Value="#1E1E2E"/>
            <Setter Property="AlternatingRowBackground" Value="#232336"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#313244"/>
            <Setter Property="RowHeight" Value="26"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- the rates -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Heading}" Text="{x:Static res:PricingText.TaxRatesHeading}"/>
            <TextBlock Text="{x:Static res:PricingText.TaxIncludedHint}" Foreground="#6C7086" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PricingText.Code}"/>
                <TextBox x:Name="TaxCodeBox" Width="90" Text="{Binding NewCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PricingText.Code}"/>
                <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PricingText.Name}"/>
                <TextBox x:Name="TaxNameBox" Width="160" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PricingText.Name}"/>
                <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PricingText.TaxPercent}"/>
                <TextBox x:Name="TaxPercentBox" Width="70" Text="{Binding NewPercent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PricingText.TaxPercent}"/>
                <CheckBox x:Name="TaxDefaultBox" Content="{x:Static res:PricingText.MakeDefault}" IsChecked="{Binding NewDefault}"/>
                <Button x:Name="AddTaxRateButton" Content="{x:Static res:PricingText.AddTaxRate}" Command="{Binding AddCommand}"/>
            </WrapPanel>
        </StackPanel>
        <DataGrid Grid.Row="1" x:Name="TaxRateGrid" ItemsSource="{Binding Rates}" SelectedItem="{Binding SelectedRate}" AutomationProperties.Name="{x:Static res:PricingText.TaxRatesHeading}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:PricingText.Code}" Binding="{Binding Rate.Code}" Width="110" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:PricingText.Name}" Binding="{Binding Rate.Name}" Width="*" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:PricingText.TaxPercent}" Binding="{Binding PercentText}" Width="90" ElementStyle="{StaticResource Number}"/>
                <DataGridTextColumn Header="{x:Static res:PricingText.Default}" Binding="{Binding DefaultText}" Width="80" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:PricingText.Status}" Binding="{Binding StatusText}" Width="90" ElementStyle="{StaticResource Cell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- change the selected rate -->
        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PricingText.Name}"/>
            <TextBox x:Name="EditTaxNameBox" Width="160" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PricingText.EditTaxName}"/>
            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PricingText.TaxPercent}"/>
            <TextBox x:Name="EditTaxPercentBox" Width="70" Text="{Binding EditPercent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PricingText.EditTaxPercent}"/>
            <Button x:Name="UpdateTaxRateButton" Content="{x:Static res:PricingText.ChangeTaxRate}" Command="{Binding UpdateCommand}"/>
            <Button x:Name="SetDefaultTaxButton" Content="{x:Static res:PricingText.SetDefaultTax}" Command="{Binding SetDefaultCommand}"/>
            <Button x:Name="DeactivateTaxButton" Content="{x:Static res:PricingText.DeactivateTaxRate}" Command="{Binding DeactivateCommand}"/>
        </WrapPanel>

        <!-- the rate of one product -->
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource Heading}" Text="{x:Static res:PricingText.ProductTaxHeading}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PricingText.ProductCode}"/>
                <TextBox x:Name="TaxProductBox" Width="180" Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PricingText.ProductCode}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding FindCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button x:Name="FindTaxProductButton" Content="{x:Static res:PricingText.Find}" Command="{Binding FindCommand}"/>
            </StackPanel>
            <TextBlock x:Name="ProductTaxText" Text="{Binding ProductTaxText}" Foreground="#A6E3A1" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasProduct, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock Style="{StaticResource Label}" Text="{x:Static res:PricingText.ProductTaxChoice}"/>
                <ComboBox x:Name="ProductTaxBox" Width="280" Margin="0,0,10,0" ItemsSource="{Binding Choices}" SelectedItem="{Binding ProductChoice}" DisplayMemberPath="Text"
                          AutomationProperties.Name="{x:Static res:PricingText.ProductTaxChoice}"/>
                <Button x:Name="SaveProductTaxButton" Content="{x:Static res:PricingText.SaveProductTax}" Command="{Binding SaveProductCommand}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,8,0,0">
            <TextBlock x:Name="TaxStatusText" Text="{Binding StatusMessage}" Foreground="#A6E3A1" TextWrapping="Wrap"/>
            <TextBlock x:Name="TaxErrorText" Text="{Binding ErrorMessage}" Foreground="#F38BA8" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
