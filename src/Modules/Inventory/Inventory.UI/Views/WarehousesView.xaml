<UserControl x:Class="Inventory.UI.Views.WarehousesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Inventory.UI.Resources"
             xmlns:vm="clr-namespace:Inventory.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WarehousesViewModel}">

    <!-- WAREHOUSES (FIX-01c). DataContext: WarehousesViewModel. Texts: Resources/InventoryText.resx. -->
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="WarehouseNameBox" Width="180" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static res:InventoryText.Name}" ToolTip="{x:Static res:InventoryText.Name}"/>
            <TextBox x:Name="WarehouseCodeBox" Width="90" Text="{Binding NewCode, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static res:InventoryText.Code}" ToolTip="{x:Static res:InventoryText.Code}"/>
            <TextBox x:Name="WarehouseDescriptionBox" Width="220" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static res:InventoryText.Description}" ToolTip="{x:Static res:InventoryText.Description}"/>
            <Button x:Name="AddWarehouseButton" Content="{x:Static res:InventoryText.AddWarehouse}" Command="{Binding AddCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="WarehouseGrid" ItemsSource="{Binding Warehouses}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                  Background="#181825" RowBackground="#1E1E2E" AlternatingRowBackground="#232336" Foreground="#CDD6F4"
                  BorderBrush="#313244" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244" RowHeight="28"
                  AutomationProperties.Name="{x:Static res:InventoryText.WarehousesTitle}">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#313244"/>
                    <Setter Property="Foreground" Value="#A6ADC8"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:InventoryText.Code}" Binding="{Binding Warehouse.Code}" Width="110" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:InventoryText.Name}" Binding="{Binding Warehouse.Name}" Width="*" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:InventoryText.Status}" Binding="{Binding StatusText}" Width="110" ElementStyle="{StaticResource Cell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="WarehousesStatusText" Text="{Binding StatusMessage}" Foreground="#A6E3A1" TextWrapping="Wrap"/>
            <TextBlock x:Name="WarehousesErrorText" Text="{Binding ErrorMessage}" Foreground="#F38BA8" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
