<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stage 11 data protection (client side). Implements Platform.Application.Abstractions.Security.ISecretProtector with Windows DPAPI
    (current-user scope). The only package is System.Security.Cryptography.ProtectedData: it is the .NET team's own, DPAPI is not part
    of the shared framework, and the alternative (hand-written P/Invoke or a home-made cipher with a key kept next to the data) is worse.
    No WPF, no EF, no HTTP, no business module, no cloud code.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\Platform.Core\Platform.Core.csproj" />
    <ProjectReference Include="..\..\Platform\Platform.Application\Platform.Application.csproj" />
    <ProjectReference Include="..\Client.Host\Client.Host.csproj" />
  </ItemGroup>

</Project>
