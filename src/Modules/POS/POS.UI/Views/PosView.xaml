<UserControl x:Class="POS.UI.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:POS.UI.Resources"
             xmlns:vm="clr-namespace:POS.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PosViewModel}">

    <!--
        CASHIER SCREEN (FIX-01b). DataContext: POS.UI.ViewModels.PosViewModel. All behaviour lives in the view model; every text comes from
        Resources/PosText.resx; no left/right-specific placement (the shell sets FlowDirection from the language).
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- numbers line up at their end (the end follows the reading direction) -->
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Who sells, and (until a till is open) where from -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock x:Name="CashierText" DockPanel.Dock="Left" Text="{Binding CashierText}" Foreground="#A6ADC8"/>
            <Button x:Name="CloseSessionButton" DockPanel.Dock="Right" Content="{x:Static res:PosText.CloseSession}"
                    Command="{Binding CloseSessionCommand}"
                    Visibility="{Binding HasOpenSession, Converter={StaticResource VisibleWhenTrue}}"/>
        </DockPanel>

        <StackPanel Grid.Row="1" x:Name="SessionPanel" Margin="0,0,0,12"
                    Visibility="{Binding NeedsSession, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static res:PosText.Warehouse}" Margin="0,0,8,0"/>
                <ComboBox x:Name="WarehouseBox" MinWidth="220" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}"
                          DisplayMemberPath="Name" AutomationProperties.Name="{x:Static res:PosText.Warehouse}"/>
                <Button x:Name="OpenSessionButton" Content="{x:Static res:PosText.OpenSession}" Margin="12,0,0,0" Command="{Binding OpenSessionCommand}"/>
            </StackPanel>
            <TextBlock x:Name="NoWarehousesText" Text="{x:Static res:PosText.NoWarehouses}" Foreground="#F9E2AF" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasNoWarehouses, Converter={StaticResource VisibleWhenTrue}}"/>
        </StackPanel>

        <!-- The sale in progress -->
        <Grid Grid.Row="2" x:Name="SalePanel" Visibility="{Binding HasOpenSession, Converter={StaticResource VisibleWhenTrue}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{x:Static res:PosText.ProductCode}" Margin="0,0,8,0"/>
                <TextBox x:Name="ProductCodeBox" Width="240" Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Static res:PosText.ProductCode}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="{x:Static res:PosText.Quantity}" Margin="12,0,8,0"/>
                <TextBox x:Name="QuantityBox" Width="70" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Static res:PosText.Quantity}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button x:Name="AddButton" Content="{x:Static res:PosText.Add}" Margin="12,0,0,0" Command="{Binding AddCommand}"/>
                <!-- FIX-08c: discounts, for those who may give them -->
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0" Visibility="{Binding CanGiveDiscounts, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock Text="{x:Static res:PosText.Discount}" Margin="0,0,8,0"/>
                    <TextBox x:Name="DiscountBox" Width="70" Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static res:PosText.Discount}" ToolTip="{x:Static res:PosText.DiscountHint}"/>
                    <ComboBox x:Name="DiscountKindBox" Width="80" Margin="6,0,0,0" ItemsSource="{Binding DiscountKinds}" SelectedItem="{Binding DiscountKind}"
                              DisplayMemberPath="Text" AutomationProperties.Name="{x:Static res:PosText.Discount}"/>
                    <Button x:Name="LineDiscountButton" Content="{x:Static res:PosText.DiscountOnLine}" Margin="6,0,0,0" Command="{Binding LineDiscountCommand}"/>
                    <Button x:Name="CartDiscountButton" Content="{x:Static res:PosText.DiscountOnCart}" Margin="6,0,0,0" Command="{Binding CartDiscountCommand}"/>
                </StackPanel>
                <!-- FIX-02: scans are added wherever the focus is on this screen -->
                <TextBlock x:Name="ScannerReadyText" Text="{x:Static res:PosText.ScannerReady}" Foreground="#A6E3A1" Margin="16,0,0,0"
                           Visibility="{Binding ScannerReady, Converter={StaticResource VisibleWhenTrue}}"/>
            </StackPanel>

            <!-- FIX-11: the customer of the sale (optional; code and name only) -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,8" x:Name="CustomerPanel">
                <TextBlock Text="{x:Static res:PosText.Customer}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="CustomerText" Text="{Binding CustomerText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"
                           Visibility="{Binding HasCustomer, Converter={StaticResource VisibleWhenTrue}}"/>
                <Button x:Name="RemoveCustomerButton" Content="{x:Static res:PosText.RemoveCustomer}" Margin="0,0,16,0" Command="{Binding RemoveCustomerCommand}"
                        Visibility="{Binding HasCustomer, Converter={StaticResource VisibleWhenTrue}}"/>
                <TextBox x:Name="CustomerSearchBox" Width="180" Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static res:PosText.CustomerSearchHint}"
                         AutomationProperties.Name="{x:Static res:PosText.Customer}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding FindCustomerCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button x:Name="FindCustomerButton" Content="{x:Static res:PosText.FindCustomer}" Margin="8,0,0,0" Command="{Binding FindCustomerCommand}"/>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding HasFoundCustomers, Converter={StaticResource VisibleWhenTrue}}">
                    <ComboBox x:Name="FoundCustomerBox" Width="240" ItemsSource="{Binding FoundCustomers}" SelectedItem="{Binding FoundCustomer}"
                              AutomationProperties.Name="{x:Static res:PosText.Customer}">
                        <ComboBox.ItemContainerStyle>
                            <!-- screen readers announce the customer, not the record behind it -->
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock><Run Text="{Binding Code, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="ChooseCustomerButton" Content="{x:Static res:PosText.ChooseCustomerButton}" Margin="8,0,0,0" Command="{Binding ChooseCustomerCommand}"/>
                </StackPanel>
            </WrapPanel>

            <DataGrid Grid.Row="2" x:Name="CartGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                      Background="#181825" RowBackground="#1E1E2E" AlternatingRowBackground="#232336" Foreground="#CDD6F4"
                      BorderBrush="#313244" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244" RowHeight="28"
                      AutomationProperties.Name="{x:Static res:PosText.Product}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#313244"/>
                        <Setter Property="Foreground" Value="#A6ADC8"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:PosText.Product}" Binding="{Binding ProductName}" Width="*" MinWidth="160" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="{x:Static res:PosText.Quantity}" Binding="{Binding Quantity}" Width="90" ElementStyle="{StaticResource Number}"/>
                    <DataGridTextColumn Header="{x:Static res:PosText.UnitPrice}" Binding="{Binding UnitPrice, StringFormat=N2}" Width="120" ElementStyle="{StaticResource Number}"/>
                    <DataGridTextColumn Header="{x:Static res:PosText.Discount}" Binding="{Binding Discount, StringFormat=N2}" Width="100" ElementStyle="{StaticResource Number}"/>
                    <DataGridTextColumn Header="{x:Static res:PosText.LineTotal}" Binding="{Binding LineTotal, StringFormat=N2}" Width="130" ElementStyle="{StaticResource Number}"/>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
                <Button x:Name="RemoveButton" DockPanel.Dock="Left" Content="{x:Static res:PosText.RemoveSelected}"
                        Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItem, ElementName=CartGrid}"/>
                <Button x:Name="CheckoutButton" DockPanel.Dock="Right" Content="{x:Static res:PosText.Checkout}" MinWidth="120" Margin="16,0,0,0"
                        Command="{Binding CheckoutCommand}"/>
                <!-- FIX-08b: prices include tax; the tax contained in the total -->
                <TextBlock x:Name="TaxIncludedText" DockPanel.Dock="Right" Text="{Binding TaxTotal, StringFormat=N2}" Foreground="#A6ADC8" Margin="6,0,0,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{x:Static res:PosText.TaxIncluded}" Foreground="#A6ADC8" Margin="12,0,0,0"/>
                <TextBlock x:Name="TotalText" DockPanel.Dock="Right" Text="{Binding Total, StringFormat=N2}" FontSize="18" FontWeight="Bold"/>
                <TextBlock DockPanel.Dock="Right" Text="{x:Static res:PosText.Total}" FontWeight="Bold" Margin="16,0,6,0"/>
                <TextBlock x:Name="DiscountTotalText" DockPanel.Dock="Right" Text="{Binding DiscountTotal, StringFormat=-0.00;-0.00;0.00}" Margin="6,0,0,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{x:Static res:PosText.Discount}" Margin="12,0,0,0"/>
                <TextBlock x:Name="SubtotalText" DockPanel.Dock="Right" Text="{Binding Subtotal, StringFormat=N2}"/>
                <TextBlock DockPanel.Dock="Right" Text="{x:Static res:PosText.Subtotal}" Margin="0,0,6,0"/>
            </DockPanel>
            <!-- FIX-10: how the customer pays - one or more parts; none = the whole total in cash -->
            <StackPanel Grid.Row="4" Margin="0,10,0,0" x:Name="PaymentPanel">
                <TextBlock Text="{x:Static res:PosText.PaymentsHint}" Foreground="#A6ADC8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <WrapPanel>
                    <TextBlock Text="{x:Static res:PosText.PayWith}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PaymentMethodBox" Width="100" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}"
                              DisplayMemberPath="Text" AutomationProperties.Name="{x:Static res:PosText.PayWith}"/>
                    <TextBlock Text="{x:Static res:PosText.PaymentAmount}" Margin="12,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="PaymentAmountBox" Width="90" Text="{Binding PaymentAmountText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static res:PosText.PaymentAmountHint}"
                             AutomationProperties.Name="{x:Static res:PosText.PaymentAmount}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddPaymentCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{x:Static res:PosText.PaymentNoteLabel}" Margin="12,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="PaymentNoteBox" Width="170" Text="{Binding PaymentNote, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static res:PosText.PaymentNoteHint}"
                             AutomationProperties.Name="{x:Static res:PosText.PaymentNoteLabel}"/>
                    <Button x:Name="AddPaymentButton" Content="{x:Static res:PosText.AddPayment}" Margin="12,0,0,0" Command="{Binding AddPaymentCommand}"/>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Visibility="{Binding HasPayments, Converter={StaticResource VisibleWhenTrue}}">
                        <TextBlock Text="{x:Static res:PosText.AmountDue}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AmountDueText" Text="{Binding AmountDue, StringFormat=N2}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static res:PosText.ChangeLabel}" Margin="16,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ChangeDueText" Text="{Binding ChangeDue, StringFormat=N2}" FontWeight="Bold" Foreground="#F9E2AF" VerticalAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>
                <ItemsControl x:Name="PaymentList" ItemsSource="{Binding Payments}" Margin="0,6,0,0" AutomationProperties.Name="{x:Static res:PosText.PayWith}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" MinWidth="320"/>
                                <Button Content="{x:Static res:PosText.RemovePayment}" Margin="8,0,0,0" Padding="8,1"
                                        Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{x:Static res:PosText.RemovePayment}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- What happened -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="PosStatusText" Text="{Binding StatusMessage}" Foreground="#A6E3A1" TextWrapping="Wrap"/>
            <TextBlock x:Name="PosErrorText" Text="{Binding ErrorMessage}" Foreground="#F38BA8" TextWrapping="Wrap"/>
            <TextBlock x:Name="HardwareText" Text="{Binding HardwareMessage}" Foreground="#F9E2AF" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
