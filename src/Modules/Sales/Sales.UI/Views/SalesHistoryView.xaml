<UserControl x:Class="Sales.UI.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Sales.UI.Resources"
             xmlns:vm="clr-namespace:Sales.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SalesHistoryViewModel}">

    <!-- SALES HISTORY (FIX-01c, read-only). DataContext: SalesHistoryViewModel. Texts: Resources/SalesText.resx. -->
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"/>
    </UserControl.Resources>

    <!-- MISS-08c: the period and the plain table of sales; the chosen sale's lines in a white box below -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="{x:Static res:SalesText.From}"/>
            <DatePicker DockPanel.Dock="Left" x:Name="FromDatePicker" Width="170" SelectedDate="{Binding FromDate}" AutomationProperties.Name="{x:Static res:SalesText.From}"/>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="{x:Static res:SalesText.To}" Margin="12,0,6,0"/>
            <DatePicker DockPanel.Dock="Left" x:Name="ToDatePicker" Width="170" SelectedDate="{Binding ToDate}" AutomationProperties.Name="{x:Static res:SalesText.To}"/>
            <Button DockPanel.Dock="Left" x:Name="ShowSalesButton" Content="{x:Static res:SalesText.Show}" Margin="12,0,0,0" Command="{Binding ShowCommand}"/>
            <TextBlock DockPanel.Dock="Right" x:Name="SummaryText" Text="{Binding SummaryText}" FontWeight="SemiBold"/>
        </DockPanel>

        <DataGrid Grid.Row="1" x:Name="SalesGrid" ItemsSource="{Binding Sales}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutomationProperties.Name="{x:Static res:SalesText.ScreenTitle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:SalesText.Time}" Binding="{Binding TimeText}" Width="150" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:SalesText.Reference}" Binding="{Binding Sale.Reference}" Width="*" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:SalesText.Customer}" Binding="{Binding CustomerText}" Width="200" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:SalesText.Status}" Binding="{Binding StatusText}" Width="110" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:SalesText.Items}" Binding="{Binding ItemCount}" Width="70" ElementStyle="{StaticResource Number}"/>
                <DataGridTextColumn Header="{x:Static res:SalesText.Total}" Binding="{Binding Sale.GrandTotal, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Number}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource Box}" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{x:Static res:SalesText.SelectSale}" Foreground="{DynamicResource Brush.TextSubtle}"/>
                    <TextBlock x:Name="SaleCustomerText" Text="{Binding SelectedCustomerText}" FontWeight="SemiBold" Margin="16,0,0,0"/>
                </StackPanel>
                <DataGrid x:Name="LinesGrid" ItemsSource="{Binding Lines}" IsReadOnly="True" AutomationProperties.Name="{x:Static res:SalesText.Items}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:SalesText.Sku}" Binding="{Binding ProductSku}" Width="120" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="{x:Static res:SalesText.Product}" Binding="{Binding ProductName}" Width="*" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="{x:Static res:SalesText.Quantity}" Binding="{Binding Quantity, StringFormat=0.###}" Width="70" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="{x:Static res:SalesText.UnitPrice}" Binding="{Binding UnitPrice, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="{x:Static res:SalesText.LineTotal}" Binding="{Binding LineTotal, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Number}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="SalesInfoText" Text="{Binding ResultInfo}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
            <TextBlock x:Name="SalesErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
