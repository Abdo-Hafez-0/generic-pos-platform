<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI depends on Application (use cases) and Contracts only. NO reference to Infrastructure or Domain. -->
    <ProjectReference Include="..\CashManagement.Application\CashManagement.Application.csproj" />
    <ProjectReference Include="..\CashManagement.Contracts\CashManagement.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Platform\Platform.Core\Platform.Core.csproj" />
    <!-- FIX-01d: the screen declarations, the per-action runner and the view-model base of the shell -->
    <ProjectReference Include="..\..\..\Platform\Platform.Presentation\Platform.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\CashText.resx"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedClassName="CashText"
                      StronglyTypedNamespace="CashManagement.UI.Resources"
                      StronglyTypedFileName="$(IntermediateOutputPath)CashText.Designer.cs"
                      PublicClass="true" />
  </ItemGroup>
</Project>
