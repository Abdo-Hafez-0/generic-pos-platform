<UserControl x:Class="Customers.UI.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Customers.UI.Resources"
             xmlns:vm="clr-namespace:Customers.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CustomersViewModel}">

    <!-- CUSTOMERS (FIX-01d). DataContext: CustomersViewModel. Texts: Resources/CustomersText.resx. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Margin" Value="0,6,12,6"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="RowBackground" Value="#1E1E2E"/>
            <Setter Property="AlternatingRowBackground" Value="#232336"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#313244"/>
            <Setter Property="RowHeight" Value="28"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Visibility="{Binding IsListMode, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="CustomerSearchBox" Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Static res:CustomersText.SearchHint}" ToolTip="{x:Static res:CustomersText.SearchHint}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button x:Name="CustomerSearchButton" Content="{x:Static res:CustomersText.Search}" Margin="8,0,16,0" Command="{Binding SearchCommand}"/>
                <CheckBox x:Name="ShowInactiveCustomersBox" Content="{x:Static res:CustomersText.ShowInactive}" IsChecked="{Binding ShowInactive}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="NewCustomerButton" Content="{x:Static res:CustomersText.New}" Command="{Binding NewCommand}"/>
                <Button x:Name="EditCustomerButton" Content="{x:Static res:CustomersText.Edit}" Command="{Binding EditCommand}"/>
                <Button x:Name="DeactivateCustomerButton" Content="{x:Static res:CustomersText.Deactivate}" Command="{Binding DeactivateCommand}"/>
                <Button x:Name="ReactivateCustomerButton" Content="{x:Static res:CustomersText.Reactivate}" Command="{Binding ReactivateCommand}"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="CustomerGrid" ItemsSource="{Binding Customers}" SelectedItem="{Binding Selected}"
                  Visibility="{Binding IsListMode, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="{x:Static res:CustomersText.ScreenTitle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:CustomersText.Code}" Binding="{Binding Customer.Code}" Width="110" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:CustomersText.Name}" Binding="{Binding Customer.Name}" Width="*" MinWidth="160" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:CustomersText.Email}" Binding="{Binding Customer.Email}" Width="200" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:CustomersText.Phone}" Binding="{Binding Customer.Phone}" Width="140" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:CustomersText.Status}" Binding="{Binding StatusText}" Width="90" ElementStyle="{StaticResource Cell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="CustomerEditor" MaxWidth="600" HorizontalAlignment="Left" VerticalAlignment="Top"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource VisibleWhenTrue}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="{x:Static res:CustomersText.Code}"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="CustomerCodeBox" Width="160" HorizontalAlignment="Left" Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsNew}" AutomationProperties.Name="{x:Static res:CustomersText.Code}"/>
            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{x:Static res:CustomersText.Name}"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="CustomerNameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:CustomersText.Name}"/>
            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{x:Static res:CustomersText.Email}"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="CustomerEmailBox" Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:CustomersText.Email}"/>
            <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{x:Static res:CustomersText.Phone}"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="CustomerPhoneBox" Width="220" HorizontalAlignment="Left" Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static res:CustomersText.Phone}"/>
            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{x:Static res:CustomersText.Notes}" VerticalAlignment="Top"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="CustomerNotesBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                     Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:CustomersText.Notes}"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="SaveCustomerButton" Content="{x:Static res:CustomersText.Save}" Command="{Binding SaveCommand}"/>
                <Button x:Name="CancelCustomerButton" Content="{x:Static res:CustomersText.Cancel}" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="CustomersInfoText" Text="{Binding ResultInfo}" Foreground="#A6ADC8" TextWrapping="Wrap"/>
            <TextBlock x:Name="CustomersStatusText" Text="{Binding StatusMessage}" Foreground="#A6E3A1" TextWrapping="Wrap"/>
            <TextBlock x:Name="CustomersErrorText" Text="{Binding ErrorMessage}" Foreground="#F38BA8" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
