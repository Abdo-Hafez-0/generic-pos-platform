<Project Sdk="Microsoft.NET.Sdk">
  <!--
    VENDOR ONLY, OFFLINE (MISS-04f, design 5B): turns an approved recovery (from AdminPortal, after the identity check) into a restore key
    for ONE cloud backup, with the escrow PRIVATE key kept on this machine. Makes escrow key pairs too. Never deployed to a server; makes no
    network call.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BackupEscrowRecovery</AssemblyName>
    <RootNamespace>Tools.BackupEscrowRecovery</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Security\Security.BackupEnvelope\Security.BackupEnvelope.csproj" />
    <ProjectReference Include="..\..\src\Security\Security.BackupEnvelope.Recovery\Security.BackupEnvelope.Recovery.csproj" />
  </ItemGroup>
</Project>
