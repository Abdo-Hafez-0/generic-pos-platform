<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform.Presentation (FIX-01a): what a module UI needs to take part in the desktop shell, without any UI technology.
    No WPF, no EF Core, no Client.Host: a module UI references this project and reaches neither persistence (Rule 6) nor the host.
    Screen declarations, the per-action DI scope runner, the shared view-model base and localizable texts live here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Core\Platform.Core.csproj" />
    <ProjectReference Include="..\Platform.Application\Platform.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\PresentationText.resx"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedClassName="PresentationText"
                      StronglyTypedNamespace="Platform.Presentation.Resources"
                      StronglyTypedFileName="$(IntermediateOutputPath)PresentationText.Designer.cs"
                      PublicClass="true" />
  </ItemGroup>

</Project>
