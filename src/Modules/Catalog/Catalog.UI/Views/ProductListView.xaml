<Window x:Class="Catalog.UI.Views.ProductListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Catalog" Height="500" Width="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Product Catalog"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

        <ListView Grid.Row="1" ItemsSource="{Binding Products}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="SKU" DisplayMemberBinding="{Binding Sku}" Width="100"/>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
                    <GridViewColumn Header="Category" DisplayMemberBinding="{Binding CategoryName}" Width="150"/>
                    <GridViewColumn Header="Unit" DisplayMemberBinding="{Binding UnitName}" Width="80"/>
                    <GridViewColumn Header="Sale Price" DisplayMemberBinding="{Binding SalePrice}" Width="100"/>
                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
