<UserControl x:Class="Catalog.UI.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Catalog.UI.Resources"
             xmlns:vm="clr-namespace:Catalog.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProductsViewModel}">

    <!-- PRODUCTS SCREEN (FIX-01c). DataContext: ProductsViewModel. Texts: Resources/CatalogText.resx. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Margin" Value="0,6,12,6"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- LIST MODE: search, list, actions -->
        <StackPanel Grid.Row="0" Visibility="{Binding IsListMode, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox" Width="280" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Static res:CatalogText.SearchHint}" ToolTip="{x:Static res:CatalogText.SearchHint}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button x:Name="SearchButton" Content="{x:Static res:CatalogText.Search}" Margin="8,0,16,0" Command="{Binding SearchCommand}"/>
                <CheckBox x:Name="IncludeInactiveBox" Content="{x:Static res:CatalogText.IncludeInactive}" IsChecked="{Binding IncludeInactive}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="NewProductButton" Content="{x:Static res:CatalogText.NewProduct}" Command="{Binding NewCommand}"/>
                <Button x:Name="EditProductButton" Content="{x:Static res:CatalogText.EditProduct}" Command="{Binding EditCommand}"/>
                <Button x:Name="DeactivateButton" Content="{x:Static res:CatalogText.Deactivate}" Command="{Binding DeactivateCommand}"/>
            </StackPanel>
            <TextBlock x:Name="NeedsCategoriesText" Text="{x:Static res:CatalogText.NeedCategoriesAndUnits}" Foreground="#F9E2AF" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding NeedsCategoriesAndUnits, Converter={StaticResource VisibleWhenTrue}}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="ProductGrid" ItemsSource="{Binding Products}" SelectedItem="{Binding Selected}"
                  Visibility="{Binding IsListMode, Converter={StaticResource VisibleWhenTrue}}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                  Background="#181825" RowBackground="#1E1E2E" AlternatingRowBackground="#232336" Foreground="#CDD6F4"
                  BorderBrush="#313244" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244" RowHeight="28"
                  AutomationProperties.Name="{x:Static res:CatalogText.ProductsTitle}">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#313244"/>
                    <Setter Property="Foreground" Value="#A6ADC8"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:CatalogText.Sku}" Binding="{Binding Product.Sku}" Width="120" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:CatalogText.Name}" Binding="{Binding Product.Name}" Width="*" MinWidth="160" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:CatalogText.Category}" Binding="{Binding Product.CategoryName}" Width="130" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:CatalogText.Unit}" Binding="{Binding Product.UnitAbbreviation}" Width="60" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:CatalogText.SalePrice}" Binding="{Binding Product.SalePrice, StringFormat=N2}" Width="100" ElementStyle="{StaticResource Number}"/>
                <DataGridTextColumn Header="{x:Static res:CatalogText.CostPrice}" Binding="{Binding Product.CostPrice, StringFormat=N2}" Width="100" ElementStyle="{StaticResource Number}"/>
                <DataGridTextColumn Header="{x:Static res:CatalogText.Barcodes}" Binding="{Binding BarcodesText}" Width="150" ElementStyle="{StaticResource Cell}"/>
                <DataGridTextColumn Header="{x:Static res:CatalogText.Status}" Binding="{Binding StatusText}" Width="100" ElementStyle="{StaticResource Cell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- EDIT MODE: one product -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsEditorOpen, Converter={StaticResource VisibleWhenTrue}}">
            <Grid x:Name="Editor" MaxWidth="640" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="{x:Static res:CatalogText.Sku}"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="SkuBox" Text="{Binding EditSku, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNewProduct}"
                         AutomationProperties.Name="{x:Static res:CatalogText.Sku}"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{x:Static res:CatalogText.Name}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:CatalogText.Name}"/>
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{x:Static res:CatalogText.Category}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CategoryBox" ItemsSource="{Binding Categories}" SelectedItem="{Binding EditCategory}" DisplayMemberPath="Name"
                          AutomationProperties.Name="{x:Static res:CatalogText.Category}"/>
                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{x:Static res:CatalogText.Unit}"/>
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="UnitBox" ItemsSource="{Binding Units}" SelectedItem="{Binding EditUnit}" DisplayMemberPath="Name"
                          AutomationProperties.Name="{x:Static res:CatalogText.Unit}"/>
                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{x:Static res:CatalogText.SalePrice}"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="SalePriceBox" Width="140" HorizontalAlignment="Left" Text="{Binding EditSalePrice, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Static res:CatalogText.SalePrice}"/>
                <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="{x:Static res:CatalogText.CostPrice}"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="CostPriceBox" Width="140" Text="{Binding EditCostPrice, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSeeCost}"
                             AutomationProperties.Name="{x:Static res:CatalogText.CostPrice}"/>
                    <TextBlock Text="{x:Static res:CatalogText.CostHidden}" Foreground="#6C7086" FontSize="11" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="320"
                               Visibility="{Binding CostHidden, Converter={StaticResource VisibleWhenTrue}}"/>
                </StackPanel>
                <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="{x:Static res:CatalogText.Description}"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="DescriptionBox" Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:CatalogText.Description}"/>
                <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="{x:Static res:CatalogText.Barcodes}"/>
                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="ExistingBarcodesText" Text="{Binding ExistingBarcodes}"/>
                <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="{x:Static res:CatalogText.AddBarcode}"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="BarcodeBox" Width="240" HorizontalAlignment="Left" Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Static res:CatalogText.AddBarcode}"/>
                <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="SaveButton" Content="{x:Static res:CatalogText.Save}" Command="{Binding SaveCommand}" IsDefault="True"/>
                    <Button x:Name="CancelButton" Content="{x:Static res:CatalogText.Cancel}" Command="{Binding CancelCommand}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- what happened -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="ProductsInfoText" Text="{Binding ResultInfo}" Foreground="#A6ADC8" TextWrapping="Wrap"/>
            <TextBlock x:Name="ProductsStatusText" Text="{Binding StatusMessage}" Foreground="#A6E3A1" TextWrapping="Wrap"/>
            <TextBlock x:Name="ProductsErrorText" Text="{Binding ErrorMessage}" Foreground="#F38BA8" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
