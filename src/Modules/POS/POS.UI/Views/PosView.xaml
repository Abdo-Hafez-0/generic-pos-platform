<UserControl x:Class="POS.UI.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:POS.UI.Resources"
             xmlns:vm="clr-namespace:POS.UI.ViewModels"
             xmlns:screens="clr-namespace:Platform.Presentation.Screens;assembly=Platform.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PosViewModel}">

    <!--
        CASHIER SCREEN (FIX-01b; MISS-08b design for a TOUCH screen). DataContext: POS.UI.ViewModels.PosViewModel. All behaviour lives in
        the view model; every text comes from Resources/PosText.resx; every colour from the theme; no left/right-specific placement (the
        shell sets FlowDirection from the language). The sale on the start side, the totals, the payment and Checkout fixed on the end side.
        Every control here is touch-sized (44 px and more); the rest of the application keeps normal sizes.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        </Style>
        <!-- touch sizes for the till -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,6"/>
        </Style>
        <Style x:Key="Touch.Primary" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,6"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- numbers line up at their end (the end follows the reading direction) -->
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Page}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- MISS-08c: who sells and "Close till" stand by the title (the shell shows them), so the sale gets the height of that row -->
        <StackPanel x:Key="{x:Static screens:ScreenParts.HeaderActions}" Orientation="Horizontal">
            <TextBlock x:Name="CashierText" Text="{Binding CashierText}" Style="{StaticResource Muted}" FontSize="14" Margin="0,0,14,0"/>
            <!-- MISS-10b: a return of a completed sale (by its receipt number) -->
            <Button x:Name="StartReturnButton" Content="{x:Static res:PosText.ReturnStart}" Margin="0,0,8,0" Command="{Binding StartReturnCommand}"/>
            <Button x:Name="CloseSessionButton" Content="{x:Static res:PosText.CloseSession}" Margin="0"
                    Command="{Binding CloseSessionCommand}"
                    Visibility="{Binding HasOpenSession, Converter={StaticResource VisibleWhenTrue}}"/>
        </StackPanel>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Until a till is open: where from -->
        <Border Grid.Row="1" x:Name="SessionPanel" Style="{StaticResource Panel}" HorizontalAlignment="Left" Margin="0,0,0,12" Padding="20"
                Visibility="{Binding ShowsWarehouseChoice, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel>
                <TextBlock Text="{x:Static res:PosText.Warehouse}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="WarehouseBox" MinWidth="260" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}"
                              DisplayMemberPath="Name" AutomationProperties.Name="{x:Static res:PosText.Warehouse}"/>
                    <Button x:Name="OpenSessionButton" Content="{x:Static res:PosText.OpenSession}" Margin="10,0,0,0" Style="{StaticResource Touch.Primary}"
                            Command="{Binding OpenSessionCommand}"/>
                </StackPanel>
                <TextBlock x:Name="NoWarehousesText" Text="{x:Static res:PosText.NoWarehouses}" Foreground="{DynamicResource Brush.Warning}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasNoWarehouses, Converter={StaticResource VisibleWhenTrue}}"/>
            </StackPanel>
        </Border>

        <!-- The sale in progress: the sale on the start side, the totals and payment on the end side -->
        <Grid Grid.Row="2" x:Name="SalePanel" Visibility="{Binding IsSelling, Converter={StaticResource VisibleWhenTrue}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ======== the sale -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- scan or type a code -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ProductCodeBox" Grid.Column="0" MinHeight="52" FontSize="18" Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static res:PosText.ProductCode}" Tag="{x:Static res:PosText.ScanHint}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                        <TextBlock Text="{x:Static res:PosText.Quantity}" Style="{StaticResource Muted}" Margin="0,0,8,0"/>
                        <TextBox x:Name="QuantityBox" Width="76" MinHeight="52" FontSize="18" HorizontalContentAlignment="Center"
                                 Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PosText.Quantity}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <Button x:Name="AddButton" Grid.Column="2" Content="{x:Static res:PosText.Add}" Margin="10,0,0,0" MinHeight="52" MinWidth="110" FontSize="16"
                            Style="{StaticResource Touch.Primary}" Command="{Binding AddCommand}"/>
                    <!-- FIX-02: scans are added wherever the focus is on this screen -->
                    <TextBlock x:Name="ScannerReadyText" Grid.Row="1" Grid.ColumnSpan="3" Text="{x:Static res:PosText.ScannerReady}" Foreground="{DynamicResource Brush.Success}"
                               Margin="2,6,0,0" FontSize="12" Visibility="{Binding ScannerReady, Converter={StaticResource VisibleWhenTrue}}"/>
                </Grid>

                <!-- FIX-11: the customer of the sale (optional; code and name only); FIX-08c: discounts, for those who may give them -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,10" x:Name="CustomerPanel">
                    <TextBlock Text="{x:Static res:PosText.Customer}" Style="{StaticResource Muted}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="CustomerText" Text="{Binding CustomerText}" FontWeight="SemiBold" FontSize="14" Margin="0,0,8,0"
                               Visibility="{Binding HasCustomer, Converter={StaticResource VisibleWhenTrue}}"/>
                    <Button x:Name="RemoveCustomerButton" Content="{x:Static res:PosText.RemoveCustomer}" Margin="0,0,12,0" Command="{Binding RemoveCustomerCommand}"
                            Visibility="{Binding HasCustomer, Converter={StaticResource VisibleWhenTrue}}"/>
                    <TextBox x:Name="CustomerSearchBox" Width="190" Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static res:PosText.CustomerSearchHint}" Tag="{x:Static res:PosText.CustomerPlaceholder}"
                             AutomationProperties.Name="{x:Static res:PosText.Customer}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding FindCustomerCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button x:Name="FindCustomerButton" Content="{x:Static res:PosText.FindCustomer}" Margin="8,0,0,0" Command="{Binding FindCustomerCommand}"/>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding HasFoundCustomers, Converter={StaticResource VisibleWhenTrue}}">
                        <ComboBox x:Name="FoundCustomerBox" Width="240" ItemsSource="{Binding FoundCustomers}" SelectedItem="{Binding FoundCustomer}"
                                  AutomationProperties.Name="{x:Static res:PosText.Customer}">
                            <ComboBox.ItemContainerStyle>
                                <!-- screen readers announce the customer, not the record behind it -->
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                    <Setter Property="Padding" Value="10,10"/>
                                    <Setter Property="FontSize" Value="15"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock><Run Text="{Binding Code, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="ChooseCustomerButton" Content="{x:Static res:PosText.ChooseCustomerButton}" Margin="8,0,0,0" Command="{Binding ChooseCustomerCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" Visibility="{Binding CanGiveDiscounts, Converter={StaticResource VisibleWhenTrue}}">
                        <TextBlock Text="{x:Static res:PosText.Discount}" Style="{StaticResource Muted}" Margin="0,0,8,0"/>
                        <TextBox x:Name="DiscountBox" Width="76" Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{x:Static res:PosText.Discount}" ToolTip="{x:Static res:PosText.DiscountHint}"/>
                        <ComboBox x:Name="DiscountKindBox" Width="116" Margin="6,0,0,0" ItemsSource="{Binding DiscountKinds}" SelectedItem="{Binding DiscountKind}"
                                  DisplayMemberPath="Text" AutomationProperties.Name="{x:Static res:PosText.Discount}"/>
                        <Button x:Name="LineDiscountButton" Content="{x:Static res:PosText.DiscountOnLine}" Margin="6,0,0,0" Command="{Binding LineDiscountCommand}"/>
                        <Button x:Name="CartDiscountButton" Content="{x:Static res:PosText.DiscountOnCart}" Margin="6,0,0,0" Command="{Binding CartDiscountCommand}"/>
                    </StackPanel>
                </WrapPanel>

                <!-- the cart: rows large enough for a finger -->
                <DataGrid Grid.Row="2" x:Name="CartGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                          IsReadOnly="True" RowHeight="50" FontSize="16"
                          AutomationProperties.Name="{x:Static res:PosText.Product}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:PosText.Product}" Binding="{Binding ProductName}" Width="*" MinWidth="160" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="{x:Static res:PosText.Quantity}" Binding="{Binding Quantity}" Width="80" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="{x:Static res:PosText.UnitPrice}" Binding="{Binding UnitPrice, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="{x:Static res:PosText.Discount}" Binding="{Binding Discount, StringFormat=N2}" Width="96" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="{x:Static res:PosText.LineTotal}" Binding="{Binding LineTotal, StringFormat=N2}" Width="120" ElementStyle="{StaticResource Number}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- till actions -->
                <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                    <Button x:Name="RemoveButton" Content="{x:Static res:PosText.RemoveSelected}" Margin="0,0,8,0"
                            Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItem, ElementName=CartGrid}"/>
                    <!-- MISS-07c: receipts printed again -->
                    <Button x:Name="RecentSalesButton" Content="{x:Static res:PosText.RecentSales}" Margin="0,0,8,0"
                            Command="{Binding ShowRecentCommand}" Visibility="{Binding CanReprint, Converter={StaticResource VisibleWhenTrue}}"/>
                    <Button x:Name="ReprintLastButton" Content="{x:Static res:PosText.ReprintLast}" Margin="0,0,8,0"
                            Command="{Binding ReprintLastCommand}" Visibility="{Binding CanReprint, Converter={StaticResource VisibleWhenTrue}}"/>
                </WrapPanel>
            </Grid>

            <!-- ======== the totals, the payment and Checkout -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <DockPanel LastChildFill="True">
                    <Button x:Name="CheckoutButton" DockPanel.Dock="Bottom" Content="{x:Static res:PosText.Checkout}" Style="{StaticResource Button.Checkout}"
                            MinHeight="64" FontSize="19" HorizontalAlignment="Stretch" Margin="0,14,0,0" Command="{Binding CheckoutCommand}"/>
                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" Visibility="{Binding HasPayments, Converter={StaticResource VisibleWhenTrue}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Static res:PosText.AmountDue}" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Grid.Column="1" x:Name="AmountDueText" Text="{Binding AmountDue, StringFormat=N2}" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Grid.Row="1" Text="{x:Static res:PosText.ChangeLabel}" FontSize="14"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ChangeDueText" Text="{Binding ChangeDue, StringFormat=N2}" FontWeight="SemiBold" FontSize="20"
                                   Foreground="{DynamicResource Brush.Warning}"/>
                    </Grid>

                    <!-- FIX-08b: prices include tax; the tax contained in the total -->
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{x:Static res:PosText.Subtotal}" Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SubtotalText" Text="{Binding Subtotal, StringFormat=N2}" FontSize="14"/>
                        <TextBlock Grid.Row="1" Text="{x:Static res:PosText.Discount}" Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DiscountTotalText" Text="{Binding DiscountTotal, StringFormat=&#x200E;-0.00;&#x200E;-0.00;0.00}" FontSize="14"/>
                        <TextBlock Grid.Row="2" Text="{x:Static res:PosText.TaxIncluded}" Style="{StaticResource Muted}" FontSize="14"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TaxIncludedText" Text="{Binding TaxTotal, StringFormat=N2}" Style="{StaticResource Muted}" FontSize="14"/>
                        <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                            <DockPanel>
                                <TextBlock x:Name="TotalText" DockPanel.Dock="Right" Text="{Binding Total, StringFormat=N2}" FontSize="34" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Static res:PosText.Total}" FontSize="16" FontWeight="SemiBold"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- FIX-10: how the customer pays - one or more parts; none = the whole total in cash -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Focusable="False">
                    <StackPanel x:Name="PaymentPanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="PaymentMethodBox" Grid.Column="0" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}"
                                      DisplayMemberPath="Text" AutomationProperties.Name="{x:Static res:PosText.PayWith}" ToolTip="{x:Static res:PosText.PayWith}"/>
                            <TextBox x:Name="PaymentAmountBox" Grid.Column="2" Text="{Binding PaymentAmountText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static res:PosText.PaymentAmountHint}" Tag="{x:Static res:PosText.PaymentAmount}"
                                     AutomationProperties.Name="{x:Static res:PosText.PaymentAmount}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddPaymentCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                        <!-- MISS-08c: the note and "Add payment" share a line, so the payment fits above Checkout on a 720 px window -->
                        <DockPanel Margin="0,8,0,0">
                            <Button x:Name="AddPaymentButton" DockPanel.Dock="Right" Content="{x:Static res:PosText.AddPayment}" Margin="8,0,0,0" Padding="12,4" MinWidth="0"
                                    Command="{Binding AddPaymentCommand}" ToolTip="{x:Static res:PosText.PaymentsHint}"/>
                            <TextBox x:Name="PaymentNoteBox" Text="{Binding PaymentNote, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static res:PosText.PaymentNoteHint}" Tag="{x:Static res:PosText.PaymentNoteLabel}"
                                     AutomationProperties.Name="{x:Static res:PosText.PaymentNoteLabel}"/>
                        </DockPanel>
                        <ItemsControl x:Name="PaymentList" ItemsSource="{Binding Payments}" Margin="0,8,0,0" AutomationProperties.Name="{x:Static res:PosText.PayWith}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Right" Content="{x:Static res:PosText.RemovePayment}" Margin="8,0,0,0" MinWidth="0" MinHeight="36" Padding="10,2"
                                                Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{x:Static res:PosText.RemovePayment}"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!--
            MISS-10b RETURN MODE (owner's choices 2026-10-19): the sale area becomes the return - the sale's lines with − / + and Shelf | Damaged on
            the start side, the refund with its method, the reason and "Give refund" on the end side. The sale in progress is kept meanwhile.
        -->
        <Grid Grid.Row="1" Grid.RowSpan="2" x:Name="ReturnPanel" Visibility="{Binding IsReturnMode, Converter={StaticResource VisibleWhenTrue}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- which sale: the receipt number until it is found, then its title -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Button x:Name="BackToSellingButton" DockPanel.Dock="Right" Content="{x:Static res:PosText.BackToSelling}" Margin="10,0,0,0" Command="{Binding BackToSellingCommand}"/>
                <StackPanel x:Name="FindReturnPanel" Orientation="Horizontal" Visibility="{Binding IsFindingReturn, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock Text="{x:Static res:PosText.ReceiptNumber}" Style="{StaticResource Muted}" Margin="0,0,10,0"/>
                    <TextBox x:Name="ReceiptNumberBox" Width="260" MinHeight="52" FontSize="18" Text="{Binding ReceiptNumberText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="S-1A2B3C4D" FlowDirection="LeftToRight" AutomationProperties.Name="{x:Static res:PosText.ReceiptNumber}" ToolTip="{x:Static res:PosText.ReceiptNumberHint}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding FindReturnCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button x:Name="FindReturnButton" Content="{x:Static res:PosText.FindSale}" Margin="10,0,0,0" MinHeight="52" Style="{StaticResource Touch.Primary}"
                            Command="{Binding FindReturnCommand}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding HasReturnSale, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock x:Name="ReturnTitleText" Text="{Binding ReturnTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ReturnCustomerText" Text="{Binding ReturnCustomerText}" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" x:Name="ReturnSalePanel" Visibility="{Binding HasReturnSale, Converter={StaticResource VisibleWhenTrue}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- ======== the sale's lines -->
                <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Background="{DynamicResource Brush.Surface}"
                                CornerRadius="10,10,0,0" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="110"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static res:PosText.Product}" Style="{StaticResource Muted}"/>
                                <TextBlock Grid.Column="1" Text="{x:Static res:PosText.ReturnSold}" Style="{StaticResource Muted}" TextAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Static res:PosText.ReturnLeft}" Style="{StaticResource Muted}" TextAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{x:Static res:PosText.ReturnQuantity}" Style="{StaticResource Muted}" TextAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{x:Static res:PosText.ReturnGoes}" Style="{StaticResource Muted}" TextAlignment="Center"/>
                            </Grid>
                        </Border>
                        <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,14">
                            <Button x:Name="ReturnEverythingButton" Content="{x:Static res:PosText.ReturnEverything}" HorizontalAlignment="Left" Command="{Binding ReturnEverythingCommand}"/>
                            <TextBlock x:Name="ReturnNothingLeftText" Text="{x:Static res:PosText.ReturnNothingLeft}" Foreground="{DynamicResource Brush.Warning}" FontSize="14" Margin="0,10,0,0"
                                       TextWrapping="Wrap" Visibility="{Binding ReturnNothingLeft, Converter={StaticResource VisibleWhenTrue}}"/>
                            <TextBlock x:Name="ReturnLateText" Text="{Binding ReturnLateText}" Foreground="{DynamicResource Brush.Warning}" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl x:Name="ReturnLinesList" ItemsSource="{Binding ReturnLines}" AutomationProperties.Name="{x:Static res:PosText.ReturnQuantity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="16,6" MinHeight="60"
                                                AutomationProperties.Name="{Binding ProductName}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="110"/>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="160"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="16" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SoldText}" FontSize="16" VerticalAlignment="Center" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding LeftText}" FontSize="16" VerticalAlignment="Center" TextAlignment="Center"/>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center"
                                                            Visibility="{Binding CanReturn, Converter={StaticResource VisibleWhenTrue}}">
                                                    <Button x:Name="FewerButton" Content="−" MinWidth="44" Padding="0" FontSize="20" Command="{Binding FewerCommand}"
                                                            AutomationProperties.Name="{x:Static res:PosText.ReturnFewer}" ToolTip="{x:Static res:PosText.ReturnFewer}"/>
                                                    <TextBox x:Name="ReturnQuantityBox" Width="56" Margin="4,0" FontSize="18" HorizontalContentAlignment="Center"
                                                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PosText.ReturnQuantity}"/>
                                                    <Button x:Name="MoreButton" Content="+" MinWidth="44" Padding="0" FontSize="20" Command="{Binding MoreCommand}"
                                                            AutomationProperties.Name="{x:Static res:PosText.ReturnMore}" ToolTip="{x:Static res:PosText.ReturnMore}"/>
                                                </StackPanel>
                                                <Border Grid.Column="4" Style="{StaticResource Segments}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding CanReturn, Converter={StaticResource VisibleWhenTrue}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="ShelfChoice" Style="{StaticResource Segment}" MinHeight="40" Padding="10,6" FontSize="14"
                                                                     Content="{x:Static res:PosText.ReturnShelf}" IsChecked="{Binding GoesToShelf}"/>
                                                        <RadioButton x:Name="DamagedChoice" Style="{StaticResource Segment}" MinHeight="40" Padding="10,6" FontSize="14"
                                                                     Content="{x:Static res:PosText.ReturnDamaged}" IsChecked="{Binding IsDamaged}"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Text="{x:Static res:PosText.ReturnAlreadyReturned}" Style="{StaticResource Muted}" FontSize="14"
                                                           TextAlignment="Center" Visibility="{Binding IsFullyReturned, Converter={StaticResource VisibleWhenTrue}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ======== the refund -->
                <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <DockPanel LastChildFill="False">
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="RefundTotalText" DockPanel.Dock="Right" Text="{Binding RefundTotal, StringFormat=N2}" FontSize="34" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Static res:PosText.RefundTitle}" FontSize="16" FontWeight="SemiBold"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{x:Static res:PosText.RefundBy}" Style="{StaticResource Label.Field}" FontSize="13" Margin="0,16,0,4"/>
                        <ComboBox DockPanel.Dock="Top" x:Name="RefundMethodBox" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding RefundMethod}"
                                  DisplayMemberPath="Text" AutomationProperties.Name="{x:Static res:PosText.RefundBy}"/>
                        <TextBox DockPanel.Dock="Top" x:Name="RefundNoteBox" Margin="0,8,0,0" Text="{Binding RefundNote, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{x:Static res:PosText.RefundNote}" AutomationProperties.Name="{x:Static res:PosText.RefundNote}"
                                 Visibility="{Binding RefundNeedsNote, Converter={StaticResource VisibleWhenTrue}}"/>
                        <TextBlock DockPanel.Dock="Top" Text="{x:Static res:PosText.ReturnReason}" Style="{StaticResource Label.Field}" FontSize="13" Margin="0,14,0,4"/>
                        <TextBox DockPanel.Dock="Top" x:Name="ReturnReasonBox" Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                                 MinHeight="72" VerticalContentAlignment="Top" AutomationProperties.Name="{x:Static res:PosText.ReturnReason}"/>
                        <Button DockPanel.Dock="Bottom" x:Name="GiveRefundButton" Content="{x:Static res:PosText.GiveRefund}" Style="{StaticResource Button.Checkout}"
                                MinHeight="64" FontSize="19" HorizontalAlignment="Stretch" Margin="0,14,0,0" Command="{Binding GiveRefundCommand}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- What happened -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <!-- MISS-07c: today's and yesterday's sales of this till, to print a receipt again -->
            <Border x:Name="RecentPanel" Style="{StaticResource Panel}" Margin="0,0,0,8" Visibility="{Binding IsRecentShown, Converter={StaticResource VisibleWhenTrue}}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:PosText.RecentTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    <TextBlock x:Name="NoRecentText" Text="{x:Static res:PosText.RecentNone}" Visibility="{Binding HasNoRecent, Converter={StaticResource VisibleWhenTrue}}"/>
                    <DataGrid x:Name="RecentGrid" ItemsSource="{Binding RecentReceipts}" SelectedItem="{Binding SelectedRecent}" IsReadOnly="True" MaxHeight="200"
                              RowHeight="44" FontSize="14" AutomationProperties.Name="{x:Static res:PosText.RecentTitle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static res:PosText.RecentWhen}" Binding="{Binding WhenText}" Width="170" ElementStyle="{StaticResource Cell}"/>
                            <DataGridTextColumn Header="{x:Static res:PosText.RecentReceipt}" Binding="{Binding Receipt.Reference}" Width="120" ElementStyle="{StaticResource Cell}"/>
                            <DataGridTextColumn Header="{x:Static res:PosText.RecentLines}" Binding="{Binding Receipt.Lines}" Width="70" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="{x:Static res:PosText.Total}" Binding="{Binding TotalText}" Width="100" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="{x:Static res:PosText.RecentCashier}" Binding="{Binding Receipt.Cashier}" Width="*" ElementStyle="{StaticResource Cell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="ReprintSelectedButton" Content="{x:Static res:PosText.ReprintSelected}" Style="{StaticResource Touch.Primary}" Command="{Binding ReprintSelectedCommand}"/>
                        <Button x:Name="ReturnRecentButton" Content="{x:Static res:PosText.ReturnRecent}" Margin="8,0,0,0" Command="{Binding ReturnRecentCommand}"/>
                        <Button x:Name="HideRecentButton" Content="{x:Static res:PosText.CloseRecent}" Margin="8,0,0,0" Command="{Binding HideRecentCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="PosStatusText" Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap" FontSize="14"/>
            <TextBlock x:Name="PosErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" FontSize="14"/>
            <TextBlock x:Name="HardwareText" Text="{Binding HardwareMessage}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" FontSize="14"/>
            <!-- MISS-11a-3: electronic receipts waiting too long to reach the tax authority -->
            <TextBlock x:Name="FiscalNoticeText" Text="{Binding FiscalNotice}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" FontSize="14"/>
        </StackPanel>
    </Grid>
</UserControl>
