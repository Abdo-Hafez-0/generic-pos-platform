<UserControl x:Class="CashManagement.UI.Views.CashDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:CashManagement.UI.Resources"
             xmlns:vm="clr-namespace:CashManagement.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CashDrawerViewModel}">

    <!-- CASH DRAWER (FIX-01d). DataContext: CashDrawerViewModel. Texts: Resources/CashText.resx. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"/>
    </UserControl.Resources>

    <!-- MISS-08c (owner's choices): the drawer, then white boxes - the shift and its movements with the recent shifts on one side, what can be
         done to the open shift (pay in or out, count and close) on the other -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*" MinWidth="260"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- which drawer -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource Label}" Text="{x:Static res:CashText.Drawer}"/>
            <TextBox x:Name="DrawerCodeBox" Width="120" Text="{Binding DrawerCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:CashText.Drawer}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ShowCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button x:Name="ShowDrawerButton" Content="{x:Static res:CashText.Show}" Command="{Binding ShowCommand}" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- no open shift: open one -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Box}" VerticalAlignment="Top" Visibility="{Binding HasNoOpenShift, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel>
                <TextBlock x:Name="NoShiftText" Text="{x:Static res:CashText.NoOpenSession}" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static res:CashText.OpeningFloat}"/>
                    <TextBox x:Name="OpeningFloatBox" Width="110" Text="{Binding OpeningFloat, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:CashText.OpeningFloat}"/>
                    <Button x:Name="OpenShiftButton" Style="{StaticResource Button.Primary}" Content="{x:Static res:CashText.OpenShift}" Command="{Binding OpenCommand}" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- open shift: balance and movements -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Box}" Visibility="{Binding HasOpenShift, Converter={StaticResource VisibleWhenTrue}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left" x:Name="OpenedText" Text="{Binding OpenedText}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" x:Name="BalanceText" Text="{Binding Session.Balance, StringFormat=N2}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Text="{x:Static res:CashText.Balance}" Margin="0,0,8,0"/>
                </DockPanel>
                <DataGrid x:Name="MovementGrid" ItemsSource="{Binding Movements}" IsReadOnly="True" MinHeight="100">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:CashText.Time}" Binding="{Binding TimeText}" Width="140" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="{x:Static res:CashText.Kind}" Binding="{Binding KindText}" Width="100" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="{x:Static res:CashText.Reason}" Binding="{Binding Movement.Reason}" Width="*" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="{x:Static res:CashText.By}" Binding="{Binding Movement.RecordedBy}" Width="90" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="{x:Static res:CashText.Amount}" Binding="{Binding Movement.SignedAmount, StringFormat=&#x200E;+0.00;&#x200E;-0.00}" Width="90" ElementStyle="{StaticResource Number}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- what can be done to the open shift -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasOpenShift, Converter={StaticResource VisibleWhenTrue}}">
        <StackPanel>
            <Border Style="{StaticResource Box}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Box.Title}" Text="{x:Static res:CashText.MovementHeading}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="MovementKindBox" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" DisplayMemberPath="Name" AutomationProperties.Name="{x:Static res:CashText.Kind}"/>
                        <TextBox Grid.Column="2" x:Name="MovementAmountBox" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static res:CashText.Amount}"
                                 AutomationProperties.Name="{x:Static res:CashText.Amount}"/>
                    </Grid>
                    <TextBox x:Name="MovementReasonBox" Margin="0,8,0,0" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static res:CashText.Reason}"
                             AutomationProperties.Name="{x:Static res:CashText.Reason}"/>
                    <Button x:Name="RecordMovementButton" Content="{x:Static res:CashText.Record}" Command="{Binding RecordCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Box}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Box.Title}" Text="{x:Static res:CashText.CloseHeading}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CountedBox" Text="{Binding Counted, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static res:CashText.Counted}" ToolTip="{x:Static res:CashText.Counted}"
                                 AutomationProperties.Name="{x:Static res:CashText.Counted}"/>
                        <TextBox Grid.Column="2" x:Name="CloseNotesBox" Text="{Binding CloseNotes, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static res:CashText.Notes}"
                                 AutomationProperties.Name="{x:Static res:CashText.Notes}"/>
                    </Grid>
                    <Button x:Name="CloseShiftButton" Style="{StaticResource Button.Primary}" Content="{x:Static res:CashText.CloseShift}" Command="{Binding CloseCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- recent shifts -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Box}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Box.Title}" Text="{x:Static res:CashText.RecentHeading}"/>
                <DataGrid x:Name="ShiftGrid" ItemsSource="{Binding RecentShifts}" IsReadOnly="True" MaxHeight="170">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:CashText.Opened}" Binding="{Binding OpenedText}" Width="150" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="{x:Static res:CashText.By}" Binding="{Binding Shift.OpenedBy}" Width="*" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="{x:Static res:CashText.Closed}" Binding="{Binding ClosedText}" Width="150" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="{x:Static res:CashText.Variance}" Binding="{Binding Shift.Variance, StringFormat=&#x200E;+0.00;&#x200E;-0.00;0.00}" Width="90" ElementStyle="{StaticResource Number}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,4,0,0">
            <TextBlock x:Name="CashStatusText" Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap"/>
            <TextBlock x:Name="CashErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
