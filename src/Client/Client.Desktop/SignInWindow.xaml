<Window x:Class="Client.Desktop.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Client.Desktop.Resources"
        xmlns:shell="clr-namespace:Client.Desktop.Shell"
        Title="{x:Static res:SignInText.WindowTitle}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI">

    <!--
        STAGE 11 START SCREEN
        Shown before the shell. It is glue only: every decision (first run, sign-in, lockout, password policy, forced password change)
        is made by Users.Application.Security.InteractiveSignInService and the handlers behind it. Passwords are read from PasswordBox
        controls at the moment of use and are never bound, stored or logged.
    -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}"/>
    </Window.Resources>

    <!-- MISS-08: a white card on the light surface, the Matjar logo on top -->
    <Border Margin="20" Padding="28,24" Background="{DynamicResource Brush.Page}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="10">
    <StackPanel>
        <shell:BrandMark HorizontalAlignment="Left" Margin="0,0,0,18"/>
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" Text="{x:Static res:SignInText.SignInHeading}"/>
        <TextBlock x:Name="Explanation" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,8"/>

        <!-- first-run setup and sign-in -->
        <StackPanel x:Name="IdentityPanel">
            <TextBlock Text="{x:Static res:SignInText.UserName}"/>
            <TextBox x:Name="UsernameBox"/>
            <StackPanel x:Name="DisplayNamePanel">
                <TextBlock Text="{x:Static res:SignInText.YourName}"/>
                <TextBox x:Name="DisplayNameBox"/>
            </StackPanel>
            <TextBlock x:Name="PasswordLabel" Text="{x:Static res:SignInText.Password}"/>
            <PasswordBox x:Name="PasswordBox"/>
        </StackPanel>

        <!-- new password (first run, or replacing a temporary password) -->
        <StackPanel x:Name="NewPasswordPanel">
            <TextBlock Text="{x:Static res:SignInText.NewPassword}"/>
            <PasswordBox x:Name="NewPasswordBox"/>
            <TextBlock Text="{x:Static res:SignInText.RepeatPassword}"/>
            <PasswordBox x:Name="ConfirmPasswordBox"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="{x:Static res:SignInText.Exit}" MinWidth="90" Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
            <Button x:Name="PrimaryButton" Content="{x:Static res:SignInText.SignInButton}" MinWidth="150" IsDefault="True" Click="OnPrimary" Style="{StaticResource Button.Primary}"/>
        </StackPanel>
    </StackPanel>
    </Border>
</Window>
