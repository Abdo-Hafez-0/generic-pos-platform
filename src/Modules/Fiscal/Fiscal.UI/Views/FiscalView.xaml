<UserControl x:Class="Fiscal.UI.Views.FiscalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Fiscal.UI.Resources"
             xmlns:vm="clr-namespace:Fiscal.UI.ViewModels"
             xmlns:screens="clr-namespace:Platform.Presentation.Screens;assembly=Platform.Presentation"
             xmlns:pres="clr-namespace:Platform.Presentation.Resources;assembly=Platform.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FiscalViewModel}">

    <!-- ELECTRONIC RECEIPTS (MISS-11a). DataContext: FiscalViewModel. Texts: Resources/FiscalText.resx. Owner's choice: two columns of white
         boxes for the setup, the documents underneath. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,4,16,4"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Wrapped" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4"/>
            <!-- the reasons come from the authority (and from the country part) in English: kept in their own order in Arabic -->
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"/>

        <!-- MISS-11a-3: the main action, by the title - send what waits now (when this till issues documents) -->
        <Button x:Key="{x:Static screens:ScreenParts.HeaderActions}" x:Name="SendNowButton" Style="{StaticResource Button.Primary}" Margin="0"
                Content="{x:Static res:FiscalText.SendNow}" Command="{Binding SendNowCommand}" Visibility="{Binding CanSendNow, Converter={StaticResource VisibleWhenTrue}}"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- the country and the shop's tax details -->
                <Border Grid.Column="0" Style="{StaticResource Box}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Box.Title}" Text="{x:Static res:FiscalText.ShopTitle}"/>
                        <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.Country}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CountryBox" ItemsSource="{Binding Countries}" SelectedItem="{Binding Country}" DisplayMemberPath="Text"
                                  IsEnabled="{Binding CanChooseCountry}" AutomationProperties.Name="{x:Static res:FiscalText.Country}"/>
                        <TextBlock x:Name="CountryLockedText" Text="{x:Static res:FiscalText.CountryLocked}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                                   Margin="0,4,0,0" Visibility="{Binding IsCountryLocked, Converter={StaticResource VisibleWhenTrue}}"/>

                        <StackPanel x:Name="DetailsPanel" Visibility="{Binding NeedsDetails, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.TaxNumber}"/>
                            <TextBox x:Name="TaxNumberBox" Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                                     Tag="{Binding TaxNumberHint}" AutomationProperties.Name="{x:Static res:FiscalText.TaxNumber}"/>
                            <Grid Visibility="{Binding IsEgypt, Converter={StaticResource VisibleWhenTrue}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.BranchCode}"/>
                                    <TextBox x:Name="BranchCodeBox" Text="{Binding BranchCode, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                                             Tag="0" AutomationProperties.Name="{x:Static res:FiscalText.BranchCode}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.ActivityCode}"/>
                                    <TextBox x:Name="ActivityCodeBox" Text="{Binding ActivityCode, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                                             AutomationProperties.Name="{x:Static res:FiscalText.ActivityCode}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.SellerNameArabic}"/>
                            <TextBox x:Name="SellerNameBox" Text="{Binding SellerNameArabic, UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft"
                                     AutomationProperties.Name="{x:Static res:FiscalText.SellerNameArabic}"/>
                            <!-- MISS-11d (owner's choice, drawn option A): Saudi Arabia - the seller's identification and the national address -->
                            <StackPanel x:Name="SaudiPanel" Visibility="{Binding IsSaudi, Converter={StaticResource VisibleWhenTrue}}">
                                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.SellerIdType}"/>
                                <ComboBox x:Name="SellerIdTypeBox" ItemsSource="{Binding SellerIdTypes}" SelectedItem="{Binding SellerIdType}" DisplayMemberPath="Text"
                                          AutomationProperties.Name="{x:Static res:FiscalText.SellerIdType}"/>
                                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.SellerId}"/>
                                <TextBox x:Name="SellerIdBox" Text="{Binding SellerId, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                                         AutomationProperties.Name="{x:Static res:FiscalText.SellerId}"/>
                                <TextBlock Text="{x:Static res:FiscalText.NationalAddress}" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.BuildingNumber}"/>
                                        <TextBox x:Name="SaudiBuildingNumberBox" Text="{Binding BuildingNumber, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                                                 Tag="2322" AutomationProperties.Name="{x:Static res:FiscalText.BuildingNumber}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.AdditionalNumber}"/>
                                        <TextBox x:Name="AdditionalNumberBox" Text="{Binding AdditionalNumber, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                                                 AutomationProperties.Name="{x:Static res:FiscalText.AdditionalNumber}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.Street}"/>
                                <TextBox x:Name="SaudiStreetBox" Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft"
                                         AutomationProperties.Name="{x:Static res:FiscalText.Street}"/>
                                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.District}"/>
                                <TextBox x:Name="DistrictBox" Text="{Binding District, UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft"
                                         AutomationProperties.Name="{x:Static res:FiscalText.District}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.City}"/>
                                        <TextBox x:Name="SaudiCityBox" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft"
                                                 AutomationProperties.Name="{x:Static res:FiscalText.City}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.PostalCode}"/>
                                        <TextBox x:Name="SaudiPostalCodeBox" Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                                                 Tag="12214" AutomationProperties.Name="{x:Static res:FiscalText.PostalCode}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <!-- MISS-11c: Egypt - the branch address in the authority's fields -->
                            <StackPanel x:Name="EgyptAddressPanel" Visibility="{Binding IsEgypt, Converter={StaticResource VisibleWhenTrue}}">
                                <TextBlock Text="{x:Static res:FiscalText.AddressArabic}" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Visibility="{Binding IsEgypt, Converter={StaticResource VisibleWhenTrue}}">
                                            <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.Governorate}"/>
                                            <ComboBox x:Name="GovernorateBox" ItemsSource="{Binding Governorates}" SelectedItem="{Binding Governorate}" FlowDirection="RightToLeft"
                                                      AutomationProperties.Name="{x:Static res:FiscalText.Governorate}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.City}"/>
                                        <TextBox x:Name="CityBox" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft"
                                                 AutomationProperties.Name="{x:Static res:FiscalText.City}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.Street}"/>
                                <TextBox x:Name="StreetBox" Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft"
                                         AutomationProperties.Name="{x:Static res:FiscalText.Street}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.BuildingNumber}"/>
                                        <TextBox x:Name="BuildingNumberBox" Text="{Binding BuildingNumber, UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft"
                                                 AutomationProperties.Name="{x:Static res:FiscalText.BuildingNumber}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.PostalCode}"/>
                                        <TextBox x:Name="PostalCodeBox" Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                                                 AutomationProperties.Name="{x:Static res:FiscalText.PostalCode}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.Floor}"/>
                                        <TextBox x:Name="FloorBox" Text="{Binding Floor, UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft"
                                                 AutomationProperties.Name="{x:Static res:FiscalText.Floor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.Room}"/>
                                        <TextBox x:Name="RoomBox" Text="{Binding Room, UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft"
                                                 AutomationProperties.Name="{x:Static res:FiscalText.Room}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.Landmark}"/>
                                <TextBox x:Name="LandmarkBox" Text="{Binding Landmark, UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft"
                                         AutomationProperties.Name="{x:Static res:FiscalText.Landmark}"/>
                                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:FiscalText.AdditionalInformation}"/>
                                <TextBox x:Name="MoreDetailsBox" Text="{Binding AdditionalInformation, UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft"
                                         AutomationProperties.Name="{x:Static res:FiscalText.AdditionalInformation}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="SaveFiscalButton" Content="{x:Static res:FiscalText.Save}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <!-- this till -->
                <Border Grid.Column="2" Style="{StaticResource Box}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Box.Title}" Text="{x:Static res:FiscalText.TillTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="{x:Static res:FiscalText.TillName}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TillNameText" Text="{Binding TillName}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{x:Static res:FiscalText.TillRegistration}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TillRegistrationText" Text="{Binding TillRegistrationText}"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{x:Static res:FiscalText.NextNumber}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="NextNumberText" Text="{Binding NextNumberText}"/>
                            <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{x:Static res:FiscalText.DeviceSerial}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="DeviceSerialText" Text="{Binding DeviceSerial, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight"
                                     HorizontalAlignment="Left" MinWidth="180" ToolTip="{x:Static res:FiscalText.DeviceSerialHint}" AutomationProperties.Name="{x:Static res:FiscalText.DeviceSerial}"/>
                            <!-- MISS-11c-3 (owner's choice, drawn option B): the registration as a summary; the details in a window -->
                            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{x:Static res:FiscalText.Environment}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="EnvironmentText" Text="{Binding EnvironmentText}"/>
                            <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="{x:Static res:FiscalText.ClientId}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ClientIdText" Text="{Binding ClientIdText}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="{x:Static res:FiscalText.LastSignIn}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LastSignInText" Text="{Binding LastSignInText}"/>
                        </Grid>
                        <TextBlock x:Name="IssuingText" Text="{Binding IssuingText}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,10,0,0"/>
                        <WrapPanel Margin="0,12,0,0" Visibility="{Binding IsEgypt, Converter={StaticResource VisibleWhenTrue}}">
                            <Button x:Name="RegisterTillButton" Content="{x:Static res:FiscalText.TillRegister}" Click="OnRegisterTill" Margin="0,0,8,0" Padding="12,4"/>
                            <Button x:Name="TestSignInButton" Content="{x:Static res:FiscalText.TillTestSignIn}" Command="{Binding TestSignInCommand}" Padding="12,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- MISS-11b: the codes the tax authority needs (owner's decision: all of them here) -->
            <Border x:Name="CodesBox" Style="{StaticResource Box}" DataContext="{Binding Codes}" Visibility="{Binding IsShown, Converter={StaticResource VisibleWhenTrue}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Segments}" Visibility="{Binding IsEgypt, Converter={StaticResource VisibleWhenTrue}}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="CodesProductsTab" Style="{StaticResource Segment}" Content="{Binding ProductsTabText}" IsChecked="{Binding ShowProductsSection}"/>
                                <RadioButton x:Name="CodesUnitsTab" Style="{StaticResource Segment}" Content="{Binding UnitsTabText}" IsChecked="{Binding ShowUnitsSection}"/>
                                <RadioButton x:Name="CodesTaxRatesTab" Style="{StaticResource Segment}" Content="{Binding TaxRatesTabText}" IsChecked="{Binding ShowTaxRatesSection}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Box.Title}" Text="{x:Static res:FiscalText.CodesTitle}" Margin="0"/>
                    </DockPanel>
                    <TextBlock x:Name="CodesMissingText" Text="{Binding MissingText}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,8"/>

                    <!-- products (Egypt) -->
                    <StackPanel Visibility="{Binding ShowsProducts, Converter={StaticResource VisibleWhenTrue}}">
                        <CheckBox x:Name="OnlyMissingBox" Content="{x:Static res:FiscalText.CodesOnlyMissing}" IsChecked="{Binding OnlyMissing}" Margin="0,0,0,8"/>
                        <DataGrid x:Name="ProductCodesGrid" ItemsSource="{Binding VisibleProducts}" IsReadOnly="True" MaxHeight="320" AutomationProperties.Name="{x:Static res:FiscalText.CodesProducts}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static res:FiscalText.CodesProduct}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Cell}"/>
                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" ElementStyle="{StaticResource Cell}"/>
                                <DataGridTextColumn Header="{x:Static res:FiscalText.CodesBarcode}" Binding="{Binding Barcode}" Width="130" ElementStyle="{StaticResource Cell}"/>
                                <DataGridTemplateColumn Header="{x:Static res:FiscalText.CodesType}" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Margin="2" AutomationProperties.Name="{x:Static res:FiscalText.CodesType}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{x:Static res:FiscalText.CodesCode}" Width="240">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="2" AutomationProperties.Name="{Binding Name}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="" Binding="{Binding SourceText}" Width="110" ElementStyle="{StaticResource Cell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="SuggestCodesButton" Content="{x:Static res:FiscalText.CodesSuggest}" Command="{Binding SuggestCommand}" Margin="0,0,8,0"/>
                            <Button x:Name="ExportCodesButton" Content="{x:Static res:FiscalText.CodesExport}" Click="OnExportCodes"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- units (Egypt) -->
                    <DataGrid x:Name="UnitCodesGrid" ItemsSource="{Binding Units}" IsReadOnly="True" MaxHeight="320" AutomationProperties.Name="{x:Static res:FiscalText.CodesUnits}"
                              Visibility="{Binding ShowsUnits, Converter={StaticResource VisibleWhenTrue}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static res:FiscalText.CodesUnit}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Cell}"/>
                            <DataGridTextColumn Header="{x:Static res:FiscalText.CodesAbbreviation}" Binding="{Binding Abbreviation}" Width="120" ElementStyle="{StaticResource Cell}"/>
                            <DataGridTemplateColumn Header="{x:Static res:FiscalText.CodesUnitCode}" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Margin="2" FlowDirection="LeftToRight"
                                                  ItemsSource="{Binding DataContext.UnitCodeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" AutomationProperties.Name="{Binding Name}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- tax rates: Egypt (tax type and subtype) -->
                    <DataGrid x:Name="EgyptTaxCodesGrid" ItemsSource="{Binding TaxRates}" IsReadOnly="True" MaxHeight="320" AutomationProperties.Name="{x:Static res:FiscalText.CodesTaxRates}"
                              Visibility="{Binding ShowsEgyptTaxRates, Converter={StaticResource VisibleWhenTrue}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static res:FiscalText.CodesTaxRate}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Cell}"/>
                            <DataGridTextColumn Header="%" Binding="{Binding RateText}" Width="70" ElementStyle="{StaticResource Number}"/>
                            <DataGridTemplateColumn Header="{x:Static res:FiscalText.CodesEgyptType}" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" Text="{Binding EgyptTaxType, UpdateSourceTrigger=PropertyChanged}" Margin="2" FlowDirection="LeftToRight"
                                                  ItemsSource="{Binding DataContext.EgyptTaxTypeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" AutomationProperties.Name="{x:Static res:FiscalText.CodesEgyptType}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static res:FiscalText.CodesEgyptSubType}" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" Text="{Binding EgyptSubType, UpdateSourceTrigger=PropertyChanged}" Margin="2" FlowDirection="LeftToRight"
                                                  ItemsSource="{Binding DataContext.EgyptSubTypeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" AutomationProperties.Name="{x:Static res:FiscalText.CodesEgyptSubType}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- tax rates: Saudi Arabia (VAT category, and the exemption reason unless standard) -->
                    <DataGrid x:Name="SaudiTaxCodesGrid" ItemsSource="{Binding TaxRates}" IsReadOnly="True" MaxHeight="320" AutomationProperties.Name="{x:Static res:FiscalText.CodesTaxRates}"
                              Visibility="{Binding IsSaudi, Converter={StaticResource VisibleWhenTrue}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static res:FiscalText.CodesTaxRate}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Cell}"/>
                            <DataGridTextColumn Header="%" Binding="{Binding RateText}" Width="70" ElementStyle="{StaticResource Number}"/>
                            <DataGridTemplateColumn Header="{x:Static res:FiscalText.CodesSaudiCategory}" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding SaudiCategory}" Margin="2"
                                                  ItemsSource="{Binding DataContext.SaudiCategoryChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" AutomationProperties.Name="{x:Static res:FiscalText.CodesSaudiCategory}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static res:FiscalText.CodesSaudiReasonCode}" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" Text="{Binding SaudiExemptionCode, UpdateSourceTrigger=PropertyChanged}" Margin="2" FlowDirection="LeftToRight" IsEnabled="{Binding NeedsReason}"
                                                  ItemsSource="{Binding DataContext.SaudiReasonChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" AutomationProperties.Name="{x:Static res:FiscalText.CodesSaudiReasonCode}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static res:FiscalText.CodesSaudiReason}" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding SaudiExemptionReason, UpdateSourceTrigger=PropertyChanged}" Margin="2" IsEnabled="{Binding NeedsReason}"
                                                 AutomationProperties.Name="{x:Static res:FiscalText.CodesSaudiReason}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Margin="0,12,0,0">
                        <Button x:Name="SaveCodesButton" DockPanel.Dock="Right" Content="{x:Static res:FiscalText.CodesSave}" Command="{Binding SaveCommand}" Style="{StaticResource Button.Primary}"/>
                        <StackPanel>
                            <TextBlock x:Name="CodesStatusText" Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Success}"/>
                            <TextBlock x:Name="CodesErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- the documents (MISS-11a-3) -->
            <Border Style="{StaticResource Box}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ComboBox x:Name="DocumentFilterBox" Width="220" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" DisplayMemberPath="Text"
                                      AutomationProperties.Name="{x:Static res:FiscalText.DocumentsTitle}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Box.Title}" Text="{x:Static res:FiscalText.DocumentsTitle}" Margin="0"/>
                    </DockPanel>
                    <TextBlock x:Name="AlertsText" Text="{Binding AlertsText}" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AlertsNeedAttention}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- MISS-11c-4 (owner's choice A): the late receipts and their button, only when there are some -->
                    <Border x:Name="LatePanel" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                            Visibility="{Binding HasLate, Converter={StaticResource VisibleWhenTrue}}">
                        <DockPanel>
                            <Button x:Name="SendLateButton" DockPanel.Dock="Right" Content="{x:Static res:FiscalText.SendLate}" Command="{Binding SendLateCommand}" Padding="12,4" Margin="8,0,0,0"/>
                            <TextBlock x:Name="LateText" Text="{Binding LateText}" Foreground="{DynamicResource Brush.Warning}"/>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="NoDocumentsText" Text="{x:Static res:FiscalText.NoDocuments}" Foreground="{DynamicResource Brush.TextMuted}"
                               Visibility="{Binding HasNoDocuments, Converter={StaticResource VisibleWhenTrue}}"/>
                    <DataGrid x:Name="DocumentsGrid" ItemsSource="{Binding Documents}" IsReadOnly="True" MaxHeight="360" RowHeight="NaN" MinRowHeight="34" AutomationProperties.Name="{x:Static res:FiscalText.DocumentsTitle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static res:FiscalText.ColumnTime}" Binding="{Binding TimeText}" Width="150" ElementStyle="{StaticResource Cell}"/>
                            <DataGridTextColumn Header="{x:Static res:FiscalText.ColumnReceipt}" Binding="{Binding Document.Reference}" Width="110" ElementStyle="{StaticResource Cell}"/>
                            <DataGridTextColumn Header="{x:Static res:FiscalText.ColumnKind}" Binding="{Binding KindText}" Width="150" ElementStyle="{StaticResource Cell}"/>
                            <DataGridTextColumn Header="{x:Static res:FiscalText.ColumnNumber}" Binding="{Binding NumberText}" Width="60" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="{x:Static res:FiscalText.ColumnTotal}" Binding="{Binding TotalText}" Width="90" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="{x:Static res:FiscalText.ColumnState}" Binding="{Binding StateText}" Width="150" ElementStyle="{StaticResource Cell}"/>
                            <DataGridTextColumn Header="{x:Static res:FiscalText.ColumnReason}" Binding="{Binding Document.StateReason}" Width="*" MinWidth="160" ElementStyle="{StaticResource Wrapped}"/>
                            <!-- MISS-11c-4: a refused or not-built document's "…": Correct and resend / Build and send -->
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="RowMenuButton" Style="{StaticResource Button.RowMenu}" Margin="4,0" ToolTip="{x:Static pres:PresentationText.RowMoreActions}"
                                                AutomationProperties.Name="{x:Static pres:PresentationText.RowMoreActions}"
                                                Visibility="{Binding CanCorrect, Converter={StaticResource VisibleWhenTrue}}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem x:Name="RowCorrectItem" Header="{Binding CorrectText}" CommandParameter="{Binding}"
                                                              Command="{Binding PlacementTarget.Tag.CorrectRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="FiscalStatusText" Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Success}" Margin="0,4,0,0"/>
            <TextBlock x:Name="FiscalErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
