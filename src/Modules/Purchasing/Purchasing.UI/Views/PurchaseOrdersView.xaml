<UserControl x:Class="Purchasing.UI.Views.PurchaseOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Purchasing.UI.Resources"
             xmlns:vm="clr-namespace:Purchasing.UI.ViewModels"
             xmlns:screens="clr-namespace:Platform.Presentation.Screens;assembly=Platform.Presentation"
             xmlns:pres="clr-namespace:Platform.Presentation.Resources;assembly=Platform.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PurchaseOrdersViewModel}">

    <!-- PURCHASE ORDERS (FIX-01d). DataContext: PurchaseOrdersViewModel. Texts: Resources/PurchasingText.resx. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"/>

        <!-- MISS-08c: the main action, shown by the shell at the end of the title row -->
        <Button x:Key="{x:Static screens:ScreenParts.HeaderActions}" x:Name="NewOrderButton" Style="{StaticResource Button.Primary}" Margin="0"
                Content="{x:Static res:PurchasingText.NewHeading}" Command="{Binding NewOrderCommand}"/>
    </UserControl.Resources>

    <!-- MISS-08c (owner's choices): the plain list of orders; beside it the chosen order in a white box (its lines, then one section per
         thing that can be done), or the new-order form opened by "New order" by the title -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- the orders -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <ComboBox x:Name="OrderStatusFilter" Width="160" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" DisplayMemberPath="Name"
                          AutomationProperties.Name="{x:Static res:PurchasingText.Status}"/>
                <Button x:Name="ShowOrdersButton" Content="{x:Static res:PurchasingText.Show}" Command="{Binding ShowCommand}" Margin="8,0,0,0"/>
            </StackPanel>
            <DataGrid x:Name="OrderGrid" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True" AutomationProperties.Name="{x:Static res:PurchasingText.ScreenTitle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:PurchasingText.Number}" Binding="{Binding Order.Number}" Width="110" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="{x:Static res:PurchasingText.Supplier}" Binding="{Binding Order.SupplierName}" Width="*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="{x:Static res:PurchasingText.Status}" Binding="{Binding StatusText}" Width="105" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="{x:Static res:PurchasingText.Total}" Binding="{Binding Order.TotalAmount, StringFormat=N2}" Width="90" ElementStyle="{StaticResource Number}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- nothing chosen yet -->
        <TextBlock Grid.Column="2" Text="{x:Static res:PurchasingText.SelectOrder}" Foreground="{DynamicResource Brush.TextSubtle}" VerticalAlignment="Top" Margin="0,8,0,0"
                   Visibility="{Binding ShowsHint, Converter={StaticResource VisibleWhenTrue}}"/>

        <!-- a new order -->
        <Border Grid.Column="2" x:Name="NewOrderPanel" Style="{StaticResource Panel.Side}" Margin="0" VerticalAlignment="Top"
                Visibility="{Binding IsCreating, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel>
                <TextBlock Style="{StaticResource Box.Title}" Text="{x:Static res:PurchasingText.NewHeading}"/>
                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:PurchasingText.SupplierHint}" Margin="0,0,0,4"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="FindSupplierButton" Content="{x:Static res:PurchasingText.FindSupplier}" Command="{Binding FindSupplierCommand}" Margin="8,0,0,0"/>
                    <TextBox x:Name="SupplierSearchBox" Text="{Binding SupplierText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PurchasingText.SupplierHint}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding FindSupplierCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:PurchasingText.Supplier}"/>
                <ComboBox x:Name="SupplierBox" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name"
                          AutomationProperties.Name="{x:Static res:PurchasingText.Supplier}"/>
                <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:PurchasingText.Reference}"/>
                <TextBox x:Name="OrderReferenceBox" Text="{Binding NewReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:PurchasingText.Reference}"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="CreateOrderButton" Style="{StaticResource Button.Primary}" Content="{x:Static res:PurchasingText.CreateOrder}" Command="{Binding CreateCommand}" Margin="0,0,8,0"/>
                    <Button x:Name="CancelNewOrderButton" Content="{x:Static pres:PresentationText.PanelCancel}" Command="{Binding CancelNewCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- the chosen order -->
        <Border Grid.Column="2" Style="{StaticResource Box}" Margin="0" Visibility="{Binding ShowsOrder, Converter={StaticResource VisibleWhenTrue}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="OrderHeadingText" Style="{StaticResource Box.Title}" Text="{Binding OrderHeading}"/>

                <ScrollViewer DockPanel.Dock="Bottom" VerticalScrollBarVisibility="Auto" MaxHeight="260" Margin="0,10,0,0">
                    <StackPanel>
                        <!-- returns made -->
                        <StackPanel Visibility="{Binding HasReturns, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:PurchasingText.ReturnsHeading}" Margin="0,0,0,2"/>
                            <ItemsControl x:Name="ReturnList" ItemsSource="{Binding Returns}" AutomationProperties.Name="{x:Static res:PurchasingText.ReturnsHeading}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- add a line (draft) -->
                        <StackPanel Visibility="{Binding IsDraft, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:PurchasingText.AddLineHeading}" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <TextBox x:Name="LineCodeBox" Width="140" Margin="0,0,8,6" Text="{Binding LineCode, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static res:PurchasingText.ProductCode}"
                                         AutomationProperties.Name="{x:Static res:PurchasingText.ProductCode}"/>
                                <TextBox x:Name="LineQuantityBox" Width="80" Margin="0,0,8,6" Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static res:PurchasingText.Quantity}"
                                         AutomationProperties.Name="{x:Static res:PurchasingText.Quantity}"/>
                                <TextBox x:Name="LineCostBox" Width="90" Margin="0,0,8,6" Text="{Binding LineCost, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static res:PurchasingText.UnitCost}"
                                         ToolTip="{x:Static res:PurchasingText.UnitCostHint}" AutomationProperties.Name="{x:Static res:PurchasingText.UnitCost}"/>
                                <Button x:Name="AddLineButton" Content="{x:Static res:PurchasingText.AddLine}" Command="{Binding AddLineCommand}" Margin="0,0,8,6"/>
                                <Button x:Name="RemoveLineButton" Content="{x:Static res:PurchasingText.RemoveLine}" Command="{Binding RemoveLineCommand}" Margin="0,0,8,6"/>
                            </WrapPanel>
                            <Button x:Name="SubmitOrderButton" Style="{StaticResource Button.Primary}" Content="{x:Static res:PurchasingText.Submit}" Command="{Binding SubmitCommand}"
                                    HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>
                        <!-- receive (awaiting goods) -->
                        <StackPanel Visibility="{Binding IsAwaitingGoods, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Label.Field}" TextWrapping="Wrap" Margin="0,0,0,4" Text="{x:Static res:PurchasingText.ReceiveNowHint}"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="ReceiveWarehouseBox" Width="180" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name"
                                          AutomationProperties.Name="{x:Static res:PurchasingText.Warehouse}" ToolTip="{x:Static res:PurchasingText.Warehouse}"/>
                                <Button x:Name="ReceiveOrderButton" Style="{StaticResource Button.Primary}" Content="{x:Static res:PurchasingText.Receive}" Command="{Binding ReceiveCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- return goods (received) -->
                        <StackPanel Visibility="{Binding ShowsReturnControls, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Label.Field}" TextWrapping="Wrap" Margin="0,0,0,4" Text="{x:Static res:PurchasingText.ReturnHint}"/>
                            <WrapPanel>
                                <TextBox x:Name="ReturnQuantityBox" Width="80" Margin="0,0,8,6" Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static res:PurchasingText.ReturnQuantity}"
                                         AutomationProperties.Name="{x:Static res:PurchasingText.ReturnQuantity}"/>
                                <TextBox x:Name="ReturnReasonBox" Width="220" Margin="0,0,8,6" Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static res:PurchasingText.ReturnReason}"
                                         AutomationProperties.Name="{x:Static res:PurchasingText.ReturnReason}"/>
                                <Button x:Name="ReturnButton" Content="{x:Static res:PurchasingText.ReturnButton}" Command="{Binding ReturnCommand}" Margin="0,0,8,6"/>
                            </WrapPanel>
                        </StackPanel>
                        <!-- cancel, or close short -->
                        <StackPanel Visibility="{Binding CanEnd, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Style="{StaticResource Label.Field}" Text="{x:Static res:PurchasingText.CancelReason}" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <TextBox x:Name="CancelReasonBox" Width="220" Margin="0,0,8,6" Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{x:Static res:PurchasingText.CancelReason}"/>
                                <Button x:Name="CancelOrderButton" Content="{x:Static res:PurchasingText.CancelOrder}" Command="{Binding CancelOrderCommand}" Margin="0,0,8,6"/>
                                <Button x:Name="CloseShortButton" Content="{x:Static res:PurchasingText.CloseShort}" Command="{Binding CloseShortCommand}" ToolTip="{x:Static res:PurchasingText.CloseShortHint}"
                                        Margin="0,0,8,6" Visibility="{Binding IsPartiallyReceived, Converter={StaticResource VisibleWhenTrue}}"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <DataGrid x:Name="OrderLineGrid" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" AutomationProperties.Name="{x:Static res:PurchasingText.Product}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:PurchasingText.ProductCode}" Binding="{Binding ProductSku}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="{x:Static res:PurchasingText.Product}" Binding="{Binding ProductName}" Width="*" MinWidth="110" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="{x:Static res:PurchasingText.Quantity}" Binding="{Binding Quantity, StringFormat=0.###}" Width="72" IsReadOnly="True" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="{x:Static res:PurchasingText.UnitCost}" Binding="{Binding UnitCost, StringFormat=N2}" Width="75" IsReadOnly="True" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="{x:Static res:PurchasingText.ReceivedColumn}" Binding="{Binding ReceivedQuantity, StringFormat=0.###}" Width="75" IsReadOnly="True" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="{x:Static res:PurchasingText.Outstanding}" Binding="{Binding OutstandingQuantity, StringFormat=0.###}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="{x:Static res:PurchasingText.ReturnedColumn}" Binding="{Binding ReturnedQuantity, StringFormat=0.###}" Width="75" IsReadOnly="True" ElementStyle="{StaticResource Number}"/>
                        <DataGridTemplateColumn Header="{x:Static res:PurchasingText.ReceiveNow}" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding ReceiveNow, UpdateSourceTrigger=PropertyChanged}" Margin="2,1" TextAlignment="Right" ToolTip="{x:Static res:PurchasingText.ReceiveNowHint}"
                                             Visibility="{Binding CanReceive, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="{x:Static res:PurchasingText.ReceiveNow}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <TextBlock x:Name="PurchasingStatusText" Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap"/>
            <TextBlock x:Name="PurchasingErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
