<Project Sdk="Microsoft.NET.Sdk">
  <!--
    HTTP transport for the update server. The ONLY client-side updater project that references HttpClient.
    Client.Updater depends on the IUpdateClient abstraction, never on this project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Client.Updater\Client.Updater.csproj" />
    <ProjectReference Include="..\..\Updates\Updates.Contracts\Updates.Contracts.csproj" />
    <ProjectReference Include="..\Client.Host\Client.Host.csproj" />
  </ItemGroup>
</Project>
