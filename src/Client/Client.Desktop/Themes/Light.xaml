<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        MATJAR LIGHT THEME (MISS-08, colours from branding/BRAND.md, palette "Emerald and sand").
        Every screen refers to these names with DynamicResource, never to a colour, so the theme can switch while the application runs.
        Dark.xaml defines the same names. Contrast (WCAG): text 15.8, muted 5.1 (4.7 on Surface), white on Accent 5.4.
    -->

    <!-- surfaces -->
    <SolidColorBrush x:Key="Brush.Page" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#F7F6F2"/>
    <SolidColorBrush x:Key="Brush.RowAlt" Color="#FBFAF7"/>
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#F1EFE9"/>
    <SolidColorBrush x:Key="Brush.Pressed" Color="#E7E4DB"/>
    <SolidColorBrush x:Key="Brush.Selected" Color="#E6F1EB"/>

    <!-- lines -->
    <SolidColorBrush x:Key="Brush.Line" Color="#E7E3D9"/>
    <SolidColorBrush x:Key="Brush.LineStrong" Color="#CFC9BB"/>

    <!-- text -->
    <SolidColorBrush x:Key="Brush.Text" Color="#1D2420"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#6B7068"/>
    <SolidColorBrush x:Key="Brush.TextSubtle" Color="#6B7068"/>
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#A3A79F"/>

    <!-- brand -->
    <SolidColorBrush x:Key="Brush.Brand" Color="#0F5132"/>
    <SolidColorBrush x:Key="Brush.Highlight" Color="#C8A96A"/>

    <!-- actions -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#0F7A4F"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#0C6942"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Checkout" Color="#0F7A4F"/>
    <SolidColorBrush x:Key="Brush.CheckoutHover" Color="#0C6942"/>
    <SolidColorBrush x:Key="Brush.OnCheckout" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ButtonFace" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.DisabledFace" Color="#F3F2EE"/>

    <!-- messages -->
    <SolidColorBrush x:Key="Brush.Success" Color="#1A7F37"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#B42318"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#8A5A00"/>
    <SolidColorBrush x:Key="Brush.Info" Color="#0F7A4F"/>
</ResourceDictionary>
