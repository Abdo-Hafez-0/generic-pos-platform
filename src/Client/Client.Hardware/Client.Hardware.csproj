<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stage 10 hardware ADAPTERS. Implements the Platform.Application.Abstractions.Hardware contracts (IBarcodeScanner, IReceiptPrinter,
    ILabelPrinter, ICashDrawer, IScale) and is the ONLY place that knows protocols (ESC/POS, ZPL), transports (TCP, device file) and
    keyboard-wedge decoding. No WPF, no EF, no business module, no cloud/server code, no vendor SDK, no System.IO.Ports.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\Platform.Core\Platform.Core.csproj" />
    <ProjectReference Include="..\..\Platform\Platform.Application\Platform.Application.csproj" />
    <!-- Client.Host: IHostingModule only (composition-root registration), same as Client.Licensing and the module Infrastructure projects. -->
    <ProjectReference Include="..\Client.Host\Client.Host.csproj" />
  </ItemGroup>

</Project>
