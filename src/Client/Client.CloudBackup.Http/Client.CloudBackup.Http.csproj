<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MISS-04e2: HTTP transport to BackupServer.Api for the optional CloudBackup module. The ONLY cloud-backup project that uses
    HttpClient (rule 7: business modules never reach HTTP). Implements IBackupClient from CloudBackup.Contracts; the module never
    references this project. No reference to any server project: the wire shape is mirrored here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Modules\CloudBackup\CloudBackup.Contracts\CloudBackup.Contracts.csproj" />
    <ProjectReference Include="..\Client.Host\Client.Host.csproj" />
  </ItemGroup>
</Project>
