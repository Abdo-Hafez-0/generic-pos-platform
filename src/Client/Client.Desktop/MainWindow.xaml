<Window x:Class="Client.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Generic POS Platform"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <!--
        APPLICATION SHELL — Stage 2

        This is the main window skeleton.
        No business UI, navigation, or functionality here.
        Business module UIs will be hosted here starting in Stage 5.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Background="#313244" Padding="16,12">
            <DockPanel LastChildFill="False">
                <TextBlock
                    DockPanel.Dock="Left"
                    Text="Generic POS Platform"
                    Foreground="#CDD6F4"
                    FontSize="18"
                    FontWeight="SemiBold"
                    FontFamily="Segoe UI"/>
                <!-- Stage 11: who is signed in, and the way out -->
                <Button x:Name="SignOutButton" DockPanel.Dock="Right" Content="Sign out" Padding="10,2" Click="OnSignOut"/>
                <TextBlock x:Name="SignedInText" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                           Foreground="#A6ADC8" FontFamily="Segoe UI"/>
            </DockPanel>
        </Border>

        <!-- Main content area — modules will be hosted here in Stage 5 -->
        <Grid Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    Text="Application host started successfully."
                    Foreground="#A6E3A1"
                    FontSize="16"
                    FontFamily="Segoe UI"
                    HorizontalAlignment="Center"/>
                <TextBlock
                    Margin="0,8,0,0"
                    Text="Stage 2 — Client Host, Module Host, DI, Configuration, and Logging are operational."
                    Foreground="#89DCEB"
                    FontSize="12"
                    FontFamily="Segoe UI"
                    HorizontalAlignment="Center"/>
                <TextBlock
                    Margin="0,4,0,0"
                    Text="Business modules will be loaded here in Stage 5."
                    Foreground="#6C7086"
                    FontSize="11"
                    FontFamily="Segoe UI"
                    HorizontalAlignment="Center"/>
                <!-- Stage 11: the license state in plain words (restrictions never touch data) -->
                <TextBlock
                    x:Name="LicenseText"
                    Margin="0,16,0,0"
                    MaxWidth="700"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="#F9E2AF"
                    FontSize="12"
                    FontFamily="Segoe UI"
                    HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#181825" Padding="16,6">
            <TextBlock
                x:Name="StatusText"
                Text="Ready"
                Foreground="#6C7086"
                FontSize="11"
                FontFamily="Segoe UI"/>
        </Border>
    </Grid>
</Window>
